# WorldView Environment - Generated by Ansible
# Google Maps Platform — 3D Tiles API key
VITE_GOOGLE_MAPS_API_KEY={{ worldview_google_maps_api_key }}

# Cesium Ion access token (for terrain/imagery fallbacks)
VITE_CESIUM_ION_TOKEN={{ worldview_cesium_ion_token }}

# OpenSky Network credentials (optional, higher rate limits)
VITE_OPENSKY_USERNAME={{ worldview_opensky_username }}
VITE_OPENSKY_PASSWORD={{ worldview_opensky_password }}

# ADS-B Exchange via RapidAPI
VITE_ADSB_API_KEY={{ worldview_adsb_api_key }}

# WiGLE API (Base64-encoded APIName:APIToken)
WIGLE_API_TOKEN={{ worldview_wigle_api_token }}

# NASA FIRMS (Fire Information for Resource Management System)
VITE_FIRMS_MAP_KEY={{ worldview_firms_map_key }}

# ACLED Conflict Data (server-side only, NOT prefixed with VITE_)
ACLED_EMAIL={{ worldview_acled_email }}
ACLED_PASSWORD={{ worldview_acled_password }}

ABUSEIPDB_API_KEY={{ worldview_abuseipdb_api_key }}

# VPS target coordinates for threat attack map arcs
VITE_VPS_LAT={{ worldview_vps_lat }}
VITE_VPS_LON={{ worldview_vps_lon }}
