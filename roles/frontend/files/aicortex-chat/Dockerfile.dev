# Expo Metro Dev Server
# Runs the Metro bundler for remote mobile development
# Source code is mounted as a volume at /app
#
# Build:  podman build -f Dockerfile.dev -t expo-dev .
# Run:    podman run -v ./:/app:Z -p 8082:8082 expo-dev

FROM node:22-alpine

# Git needed by some npm postinstall scripts
RUN apk add --no-cache git

# EAS CLI for cloud builds (eas build --platform ios/android)
RUN npm install -g eas-cli

WORKDIR /app

# Metro bundler defaults for remote hosting
ENV EXPO_NO_TELEMETRY=1 \
    EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0

EXPOSE 8082

CMD ["npx", "expo", "start", "--port", "8082"]
