# Copy to .env (gitignored) for local development.
# Expo bakes EXPO_PUBLIC_* vars into the JS bundle at build time.

# OTLP/HTTP ingest for distributed tracing.
# Token must match vault.yml:otel_ingest_token in vps_setup.
# Without this token, traces are silently dropped (no errors, no spans sent).
EXPO_PUBLIC_OTEL_TOKEN=

# Override the default OTLP endpoint if needed (e.g. local Alloy during dev).
# Defaults to https://otel.aicortex.cloud/v1/traces.
# EXPO_PUBLIC_OTEL_ENDPOINT=https://otel.aicortex.cloud/v1/traces
