#!/usr/bin/env bash
# Bring rerank-gpu up and READY before a batch, or release it afterwards.
#
# rerank-gpu is on-demand since 2026-10-05: rerank-proxy.socket owns 18092 and
# starts the container on the first connection, which costs ~14s for the model
# load. That is invisible to a single interactive query but a batch script's
# first request can hit a client-side timeout, so pre-warm instead.
#
#   rerank-ensure          start it and block until /rerank answers
#   rerank-ensure --stop   release its RAM and VRAM now, without waiting 15min
#   rerank-ensure --status report state and resource use, change nothing
set -euo pipefail

URL=http://127.0.0.1:18092
SOCK=rerank-proxy.socket

usage_now() {
    local ram vram
    ram=$(podman stats --no-stream --format '{{.MemUsage}}' rerank-gpu 2>/dev/null | cut -d/ -f1 | tr -d ' ' || true)
    vram=$(nvidia-smi --query-gpu=memory.used,memory.free --format=csv,noheader 2>/dev/null || true)
    echo "  container : $(systemctl --user is-active rerank-gpu.service)${ram:+  RAM $ram}"
    echo "  socket    : $(systemctl --user is-active $SOCK) on $(systemctl --user show $SOCK -p Listen --value | tr '\n' ' ')"
    echo "  GPU       : ${vram:-unavailable}"
}

case "${1:-}" in
  --status)
    usage_now
    exit 0
    ;;
  --stop)
    # Stopping the proxy is what the idle timer does; StopWhenUnneeded on
    # rerank-gpu then releases the RAM and VRAM. The socket stays listening, so
    # the next request still works.
    systemctl --user stop rerank-proxy.service 2>/dev/null || true
    sleep 3
    echo "Released. Socket still listening, next request will start it again."
    usage_now
    exit 0
    ;;
  -h|--help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

# The socket is normally always up; archivist-sync stops it for its nightly
# caption window, so start it rather than assume.
systemctl --user start "$SOCK"

echo "Warming rerank-gpu (model load takes ~15s on a cold start)..."
start=$(date +%s)
for _ in $(seq 1 60); do
    # A real /rerank call, not /health: it proves the model is loaded and
    # scoring, which is what the batch is about to depend on.
    if curl -sf -m 20 -o /dev/null -X POST "$URL/rerank" \
         -H 'Content-Type: application/json' \
         -d '{"query":"warmup","documents":["warmup"]}'; then
        echo "Ready in $(( $(date +%s) - start ))s."
        usage_now
        exit 0
    fi
    sleep 2
done

echo "rerank-gpu did not become ready. Check: journalctl --user-unit rerank-gpu -n 30" >&2
exit 1
