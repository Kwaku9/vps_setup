#!/bin/bash
# VPS Backup Script - Generated by Ansible
# Backs up all persistent data for VPS migration/recovery
#
# Usage: /usr/local/bin/vps-backup
# Cron:  Daily at 2:00 AM (configured by Ansible)
#
# What gets backed up:
#   - Data directories (/opt/podman-data/*)
#   - Named Podman volumes (grafana-data, loki-data, etc.)
#   - Config directories (/opt/compose)
#   - Crontab

set -euo pipefail

BACKUP_DIR="{{ backup.backup_dir }}"
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_PATH="${BACKUP_DIR}/daily/vps-backup-${DATE}"
LOG="/var/log/vps-backup.log"
ERRORS=0

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"; }
warn() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARN: $*" | tee -a "$LOG"; ERRORS=$((ERRORS + 1)); }

log "============================================================"
log "VPS Backup Starting"
log "============================================================"
log "Backup path: ${BACKUP_PATH}"

# Ensure backup directories exist
mkdir -p "${BACKUP_PATH}"/{data,volumes,config}

# ──────────────────────────────────────────────────────────
# 1. Stop non-critical pods for consistent backup
# ──────────────────────────────────────────────────────────
log "Stopping pods for consistent backup..."
{% for pod in backup.stop_pods %}
podman pod stop {{ pod }} 2>/dev/null || true
{% endfor %}

# Give pods a moment to fully stop
sleep 5

# ──────────────────────────────────────────────────────────
# 2. Backup data directories
# ──────────────────────────────────────────────────────────
log "Backing up data directories..."
{% for dir in backup.data_dirs %}
if [ -d "{{ dir }}" ]; then
    ARCHIVE_NAME=$(echo '{{ dir }}' | sed 's|^/||; s|/|_|g').tar.gz
    log "  {{ dir }} -> ${ARCHIVE_NAME}"
    tar czf "${BACKUP_PATH}/data/${ARCHIVE_NAME}" \
{% for pattern in backup.exclude_patterns %}
        --exclude='{{ pattern }}' \
{% endfor %}
        -C "$(dirname '{{ dir }}')" "$(basename '{{ dir }}')" 2>/dev/null \
        || warn "Failed to backup {{ dir }}"
else
    log "  SKIP: {{ dir }} (not found)"
fi
{% endfor %}

# ──────────────────────────────────────────────────────────
# 3. Export named Podman volumes
# ──────────────────────────────────────────────────────────
log "Exporting named volumes..."
{% for vol in backup.named_volumes %}
if podman volume exists {{ vol }} 2>/dev/null; then
    log "  {{ vol }}"
    podman volume export {{ vol }} > "${BACKUP_PATH}/volumes/{{ vol }}.tar" 2>/dev/null \
        || warn "Failed to export volume {{ vol }}"
else
    log "  SKIP: {{ vol }} (volume not found)"
fi
{% endfor %}

# ──────────────────────────────────────────────────────────
# 4. Backup config directories
# ──────────────────────────────────────────────────────────
log "Backing up configuration..."
{% for dir in backup.config_dirs %}
if [ -d "{{ dir }}" ]; then
    ARCHIVE_NAME=$(echo '{{ dir }}' | sed 's|^/||; s|/|_|g').tar.gz
    log "  {{ dir }} -> ${ARCHIVE_NAME}"
    tar czf "${BACKUP_PATH}/config/${ARCHIVE_NAME}" \
{% for pattern in backup.exclude_patterns %}
        --exclude='{{ pattern }}' \
{% endfor %}
        -C "$(dirname '{{ dir }}')" "$(basename '{{ dir }}')" 2>/dev/null \
        || warn "Failed to backup {{ dir }}"
else
    log "  SKIP: {{ dir }} (not found)"
fi
{% endfor %}

# ──────────────────────────────────────────────────────────
# 5. Backup crontab
# ──────────────────────────────────────────────────────────
log "Backing up crontab..."
crontab -l > "${BACKUP_PATH}/config/crontab.bak" 2>/dev/null || true

# ──────────────────────────────────────────────────────────
# 6. Save volume and pod metadata
# ──────────────────────────────────────────────────────────
log "Saving metadata..."
podman volume ls --format json > "${BACKUP_PATH}/config/podman-volumes.json" 2>/dev/null || true
podman pod ls --format json > "${BACKUP_PATH}/config/podman-pods.json" 2>/dev/null || true
podman ps -a --format json > "${BACKUP_PATH}/config/podman-containers.json" 2>/dev/null || true

# ──────────────────────────────────────────────────────────
# 7. Restart pods
# ──────────────────────────────────────────────────────────
log "Restarting pods..."
{% for pod in backup.stop_pods %}
podman pod start {{ pod }} 2>/dev/null || warn "Failed to start {{ pod }}"
{% endfor %}

# ──────────────────────────────────────────────────────────
# 8. Create final archive
# ──────────────────────────────────────────────────────────
log "Creating final archive..."
FINAL_ARCHIVE="${BACKUP_DIR}/daily/vps-backup-${DATE}.tar.gz"
tar czf "${FINAL_ARCHIVE}" -C "${BACKUP_PATH}" . && rm -rf "${BACKUP_PATH}"

ARCHIVE_SIZE=$(du -h "${FINAL_ARCHIVE}" | cut -f1)
log "Archive created: ${FINAL_ARCHIVE} (${ARCHIVE_SIZE})"

# ──────────────────────────────────────────────────────────
# 9. Cleanup old backups
# ──────────────────────────────────────────────────────────
log "Cleaning up backups older than {{ backup.retention_days }} days..."
DELETED=$(find "${BACKUP_DIR}/daily" -name "vps-backup-*.tar.gz" -mtime +{{ backup.retention_days }} -print -delete | wc -l)
log "Removed ${DELETED} old backup(s)"

# ──────────────────────────────────────────────────────────
# 10. Optional S3 sync
# ──────────────────────────────────────────────────────────
{% if backup.s3_enabled | default(false) %}
log "Syncing to S3..."
if command -v aws >/dev/null 2>&1; then
    aws s3 cp "${FINAL_ARCHIVE}" "s3://{{ backup.s3_bucket }}/daily/" --region {{ backup.s3_region }} \
        || warn "S3 upload failed"

    # Clean up old S3 backups (keep same retention as local)
    S3_CUTOFF=$(date -d "-{{ backup.retention_days }} days" +%Y%m%d 2>/dev/null || date -v-{{ backup.retention_days }}d +%Y%m%d 2>/dev/null || echo "")
    if [ -n "${S3_CUTOFF}" ]; then
        log "S3 cleanup: removing backups older than ${S3_CUTOFF}"
        aws s3 ls "s3://{{ backup.s3_bucket }}/daily/" --region {{ backup.s3_region }} | \
            awk '{print $4}' | while read -r f; do
                FDATE=$(echo "$f" | grep -oP '\d{8}' | head -1)
                if [ -n "${FDATE}" ] && [ "${FDATE}" -lt "${S3_CUTOFF}" ]; then
                    aws s3 rm "s3://{{ backup.s3_bucket }}/daily/$f" --region {{ backup.s3_region }} || true
                    log "  Removed S3: $f"
                fi
            done
    fi
else
    warn "aws-cli not found, skipping S3 sync"
fi
{% else %}
log "S3 sync: disabled"
{% endif %}

# ──────────────────────────────────────────────────────────
# Summary
# ──────────────────────────────────────────────────────────
log "============================================================"
if [ ${ERRORS} -eq 0 ]; then
    log "Backup COMPLETE (no errors)"
else
    log "Backup COMPLETE with ${ERRORS} warning(s)"
fi
log "  Archive: ${FINAL_ARCHIVE}"
log "  Size: ${ARCHIVE_SIZE}"
log "============================================================"

exit 0
