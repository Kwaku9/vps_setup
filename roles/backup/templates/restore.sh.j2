#!/bin/bash
# VPS Restore Script - Generated by Ansible
# Restores all persistent data from a backup archive
#
# Usage: /usr/local/bin/vps-restore /path/to/vps-backup-YYYYMMDD_HHMMSS.tar.gz
#
# What gets restored:
#   - Data directories (/opt/podman-data/*)
#   - Named Podman volumes (grafana-data, loki-data, etc.)
#   - Config directories (/opt/compose)
#   - Crontab (optional, prompted)

set -euo pipefail

LOG="/var/log/vps-restore.log"
ERRORS=0

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"; }
warn() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARN: $*" | tee -a "$LOG"; ERRORS=$((ERRORS + 1)); }

# ──────────────────────────────────────────────────────────
# Validate arguments
# ──────────────────────────────────────────────────────────
if [ $# -lt 1 ]; then
    echo "Usage: $0 <backup-archive.tar.gz>"
    echo ""
    echo "Available backups:"
    ls -lh {{ backup.backup_dir }}/daily/vps-backup-*.tar.gz 2>/dev/null || echo "  (none found)"
    exit 1
fi

BACKUP_FILE="$1"

if [ ! -f "${BACKUP_FILE}" ]; then
    echo "ERROR: Backup file not found: ${BACKUP_FILE}"
    exit 1
fi

log "============================================================"
log "VPS Restore Starting"
log "============================================================"
log "Restoring from: ${BACKUP_FILE}"
log "Archive size: $(du -h "${BACKUP_FILE}" | cut -f1)"

# ──────────────────────────────────────────────────────────
# Safety confirmation (skip if running non-interactively)
# ──────────────────────────────────────────────────────────
if [ -t 0 ]; then
    echo ""
    echo "WARNING: This will stop all pods and overwrite existing data."
    echo "Make sure you have a current backup before proceeding."
    echo ""
    read -r -p "Continue with restore? (yes/no): " CONFIRM
    if [ "${CONFIRM}" != "yes" ]; then
        log "Restore cancelled by user"
        exit 0
    fi
fi

# ──────────────────────────────────────────────────────────
# 1. Extract backup to temp directory
# ──────────────────────────────────────────────────────────
TEMP_DIR=$(mktemp -d /tmp/vps-restore-XXXXXX)
log "Extracting backup to ${TEMP_DIR}..."
tar xzf "${BACKUP_FILE}" -C "${TEMP_DIR}"

# Verify expected structure
for subdir in data volumes config; do
    if [ ! -d "${TEMP_DIR}/${subdir}" ]; then
        warn "Expected directory not found in archive: ${subdir}"
    fi
done

# ──────────────────────────────────────────────────────────
# 2. Stop all pods
# ──────────────────────────────────────────────────────────
log "Stopping all pods..."
{% for pod in backup.all_pods %}
podman pod stop {{ pod }} 2>/dev/null || true
{% endfor %}

# Give pods a moment to fully stop
sleep 5

# ──────────────────────────────────────────────────────────
# 3. Restore data directories
# ──────────────────────────────────────────────────────────
log "Restoring data directories..."
if [ -d "${TEMP_DIR}/data" ]; then
    for archive in "${TEMP_DIR}"/data/*.tar.gz; do
        [ -f "${archive}" ] || continue
        BASENAME=$(basename "${archive}" .tar.gz)
        # Convert archive name back to path: opt_podman-data_postgres -> /opt/podman-data/postgres
        RESTORE_PATH="/$(echo "${BASENAME}" | sed 's|_|/|g')"
        PARENT_DIR=$(dirname "${RESTORE_PATH}")

        if [ -d "${PARENT_DIR}" ]; then
            log "  Restoring: ${RESTORE_PATH}"
            # Remove existing data before restore
            if [ -d "${RESTORE_PATH}" ]; then
                rm -rf "${RESTORE_PATH}"
            fi
            tar xzf "${archive}" -C "${PARENT_DIR}" 2>/dev/null \
                || warn "Failed to restore ${RESTORE_PATH}"
        else
            log "  SKIP: ${RESTORE_PATH} (parent dir ${PARENT_DIR} not found)"
            warn "Parent directory missing for ${RESTORE_PATH} - create it first"
        fi
    done
else
    log "  No data archives found in backup"
fi

# ──────────────────────────────────────────────────────────
# 4. Import named Podman volumes
# ──────────────────────────────────────────────────────────
log "Importing named volumes..."
if [ -d "${TEMP_DIR}/volumes" ]; then
    for vol_archive in "${TEMP_DIR}"/volumes/*.tar; do
        [ -f "${vol_archive}" ] || continue
        VOL_NAME=$(basename "${vol_archive}" .tar)
        log "  Importing: ${VOL_NAME}"

        # Create volume if it doesn't exist
        if ! podman volume exists "${VOL_NAME}" 2>/dev/null; then
            podman volume create "${VOL_NAME}" 2>/dev/null \
                || warn "Failed to create volume ${VOL_NAME}"
        fi

        # Import volume data
        podman volume import "${VOL_NAME}" "${vol_archive}" 2>/dev/null \
            || warn "Failed to import volume ${VOL_NAME}"
    done
else
    log "  No volume archives found in backup"
fi

# ──────────────────────────────────────────────────────────
# 5. Restore config directories
# ──────────────────────────────────────────────────────────
log "Restoring configuration..."
if [ -d "${TEMP_DIR}/config" ]; then
    for archive in "${TEMP_DIR}"/config/*.tar.gz; do
        [ -f "${archive}" ] || continue
        BASENAME=$(basename "${archive}" .tar.gz)
        RESTORE_PATH="/$(echo "${BASENAME}" | sed 's|_|/|g')"
        PARENT_DIR=$(dirname "${RESTORE_PATH}")

        if [ -d "${PARENT_DIR}" ]; then
            log "  Restoring: ${RESTORE_PATH}"
            if [ -d "${RESTORE_PATH}" ]; then
                rm -rf "${RESTORE_PATH}"
            fi
            tar xzf "${archive}" -C "${PARENT_DIR}" 2>/dev/null \
                || warn "Failed to restore ${RESTORE_PATH}"
        else
            warn "Parent directory missing for ${RESTORE_PATH}"
        fi
    done
else
    log "  No config archives found in backup"
fi

# ──────────────────────────────────────────────────────────
# 6. Restore crontab (optional)
# ──────────────────────────────────────────────────────────
if [ -f "${TEMP_DIR}/config/crontab.bak" ]; then
    if [ -t 0 ]; then
        read -r -p "Restore crontab? (yes/no): " CONFIRM_CRON
        if [ "${CONFIRM_CRON}" = "yes" ]; then
            log "Restoring crontab..."
            crontab "${TEMP_DIR}/config/crontab.bak" \
                || warn "Failed to restore crontab"
        else
            log "Skipping crontab restore (user declined)"
        fi
    else
        log "Restoring crontab (non-interactive mode)..."
        crontab "${TEMP_DIR}/config/crontab.bak" \
            || warn "Failed to restore crontab"
    fi
else
    log "No crontab backup found"
fi

# ──────────────────────────────────────────────────────────
# 7. Restart all pods
# ──────────────────────────────────────────────────────────
log "Restarting all pods..."
{% for pod in backup.all_pods %}
podman pod start {{ pod }} 2>/dev/null || warn "Failed to start {{ pod }}"
{% endfor %}

# ──────────────────────────────────────────────────────────
# 8. Cleanup temp directory
# ──────────────────────────────────────────────────────────
log "Cleaning up temp files..."
rm -rf "${TEMP_DIR}"

# ──────────────────────────────────────────────────────────
# 9. Post-restore health check
# ──────────────────────────────────────────────────────────
log "Running post-restore health check..."
sleep 10

log "Pod status:"
podman pod ps --format "table {%raw%}{{.Name}}\t{{.Status}}\t{{.Containers}}{%endraw%}" 2>/dev/null | while read -r line; do
    log "  ${line}"
done

# ──────────────────────────────────────────────────────────
# Summary
# ──────────────────────────────────────────────────────────
log "============================================================"
if [ ${ERRORS} -eq 0 ]; then
    log "Restore COMPLETE (no errors)"
else
    log "Restore COMPLETE with ${ERRORS} warning(s)"
fi
log "  Source: ${BACKUP_FILE}"
log "============================================================"

if [ ${ERRORS} -gt 0 ]; then
    log "Review warnings above and verify services are running correctly."
fi

exit 0
