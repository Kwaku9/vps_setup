# Traefik Dynamic Configuration - Service Routes
# Generated by Ansible
# Subdomain routing: Cloudflare Tunnel -> Traefik -> Services
# Auth: Native OIDC per service (Grafana, Portainer, OpenWebUI handle their own)
# Updated for split pod architecture

http:
  routers:
    grafana:
      rule: "Host(`grafana.{{ domain }}`)"
      entryPoints:
        - websecure
      service: grafana
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    portainer:
      rule: "Host(`portainer.{{ domain }}`)"
      entryPoints:
        - websecure
      service: portainer
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    n8n:
      rule: "Host(`n8n.{{ domain }}`)"
      entryPoints:
        - websecure
      service: n8n
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    openwebui:
      rule: "Host(`chat.{{ domain }}`)"
      entryPoints:
        - websecure
      service: openwebui
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    prometheus:
      rule: "Host(`prometheus.{{ domain }}`)"
      entryPoints:
        - websecure
      service: prometheus
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    authentik:
      rule: "Host(`auth.{{ domain }}`)"
      entryPoints:
        - websecure
      service: authentik
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers

    litellm:
      rule: "Host(`litellm.{{ domain }}`)"
      entryPoints:
        - websecure
      service: litellm
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    traefik:
      rule: "Host(`traefik.{{ domain }}`)"
      entryPoints:
        - websecure
      service: traefik
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    kokoro-tts:
      rule: "Host(`tts.{{ domain }}`)"
      entryPoints:
        - websecure
      service: kokoro-tts
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    portal:
      rule: "Host(`portal.{{ domain }}`)"
      entryPoints:
        - websecure
      service: portal
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    otlp:
      rule: "Host(`otlp.{{ domain }}`)"
      entryPoints:
        - websecure
      service: otlp
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    telegram-bot:
      rule: "Host(`telegram-bot.{{ domain }}`)"
      entryPoints:
        - websecure
      service: telegram-bot
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    worldview:
      rule: "Host(`geo.{{ domain }}`)"
      entryPoints:
        - websecure
      service: worldview
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

    atlas-charts:
      rule: "Host(`charts.{{ domain }}`)"
      entryPoints:
        - websecure
      service: atlas-charts
      tls:
        certResolver: cloudflare
      middlewares:
        - crowdsec
        - internal-only
        - secure-headers
        - rate-limit

  services:
    grafana:
      loadBalancer:
        servers:
          - url: "http://metrics-pod:3000"

    portainer:
      loadBalancer:
        servers:
          - url: "https://management-pod:9443"
        serversTransport: skipVerify

    n8n:
      loadBalancer:
        servers:
          - url: "http://ai-stack-pod:5678"

    openwebui:
      loadBalancer:
        servers:
          - url: "http://ai-stack-pod:8080"

    prometheus:
      loadBalancer:
        servers:
          - url: "http://metrics-pod:8428"

    authentik:
      loadBalancer:
        servers:
          - url: "http://authentication-pod:9000"

    litellm:
      loadBalancer:
        servers:
          - url: "http://ai-stack-pod:4000"

    traefik:
      loadBalancer:
        servers:
          - url: "http://localhost:8080"

    kokoro-tts:
      loadBalancer:
        servers:
          - url: "http://ai-stack-pod:8880"

    portal:
      loadBalancer:
        servers:
          - url: "http://frontend-pod:80"

    otlp:
      loadBalancer:
        servers:
          - url: "http://logs-pod:4318"

    telegram-bot:
      loadBalancer:
        servers:
          - url: "http://telegram-gw-pod:7555"

    worldview:
      loadBalancer:
        servers:
          - url: "http://{{ worldview.container_name | default('worldview-dev') }}:{{ worldview.port | default('5173') }}"

    atlas-charts:
      loadBalancer:
        servers:
          - url: "http://frontend-pod:3080"

  middlewares:
    internal-only:
      ipAllowList:
        sourceRange:
          - "{{ podman_network_subnet | default('REDACTED_CIDR') }}"
          - "127.0.0.0/8"

    secure-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        frameDeny: true
        sslRedirect: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        customFrameOptionsValue: "SAMEORIGIN"

    rate-limit:
      rateLimit:
        average: 300
        burst: 200
        period: 1m

    compress:
      compress: {}

    crowdsec:
      plugin:
        crowdsec-bouncer:
          enabled: true
          crowdsecLapiScheme: http
          crowdsecLapiHost: "localhost:8180"
          crowdsecLapiKey: "{{ crowdsec_bouncer_api_key }}"
          forwardedHeadersTrustedIPs:
            - "{{ podman_network_subnet | default('REDACTED_CIDR') }}"
            - "127.0.0.0/8"

  serversTransports:
    skipVerify:
      insecureSkipVerify: true
