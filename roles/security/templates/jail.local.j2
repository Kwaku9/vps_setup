# Fail2ban Jail Configuration
# Generated by Ansible

[DEFAULT]
bantime  = {{ security.fail2ban.bantime }}
findtime = {{ security.fail2ban.findtime }}
maxretry = {{ security.fail2ban.maxretry }}
banaction = iptables-multiport
backend = auto

# Email notification settings (optional)
destemail = root@localhost
sendername = Fail2Ban
mta = sendmail
action = %(action_)s

{% if 'sshd' in security.fail2ban.jail_services %}
[sshd]
enabled = true
port = ssh
logpath = /var/log/messages
maxretry = {{ security.fail2ban.maxretry }}
{% endif %}

{% if 'nginx' in security.fail2ban.jail_services %}
[nginx-http-auth]
enabled = true
port = http,https
logpath = /var/log/nginx/error.log

[nginx-noscript]
enabled = true
port = http,https
logpath = /var/log/nginx/access.log

[nginx-badbots]
enabled = true
port = http,https
logpath = /var/log/nginx/access.log

[nginx-noproxy]
enabled = true
port = http,https
logpath = /var/log/nginx/access.log
{% endif %}
