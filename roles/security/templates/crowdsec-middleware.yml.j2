# CrowdSec Bouncer Middleware for Traefik
# Generated by Ansible
# Deployed to /opt/compose/traefik/dynamic/crowdsec.yml
http:
  middlewares:
    crowdsec:
      plugin:
        crowdsec-bouncer:
          enabled: true
          crowdsecLapiScheme: http
          crowdsecLapiHost: "localhost:8180"
          crowdsecLapiKey: "{{ crowdsec_bouncer_key }}"
          crowdsecMode: stream
          updateIntervalSeconds: 60
          defaultDecisionSeconds: 60
          clientTrustedIPs:
            - "REDACTED_CIDR"
            - "172.16.0.0/12"
            - "127.0.0.0/8"
          forwardedHeadersTrustedIPs:
            - "REDACTED_CIDR"
            - "127.0.0.0/8"
