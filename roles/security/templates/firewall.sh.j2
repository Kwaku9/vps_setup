#!/bin/bash
# IPTables Firewall Configuration
# Generated by Ansible
#
# NOTE: Podman/netavark manages its own iptables chains (NETAVARK_*).
# This script only flushes the built-in INPUT/OUTPUT/FORWARD chains
# and preserves netavark rules so container networking keeps working.

set -e

flush_builtin_chains() {
    # Flush only the built-in chains (INPUT, FORWARD, OUTPUT)
    # Do NOT flush user-defined chains (-X) or nat (-t nat -F)
    # as Podman/netavark manages those for container networking.
    iptables -F INPUT
    iptables -F FORWARD
    iptables -F OUTPUT

    # Only flush our own NAT rules, preserve netavark's
    # Remove our masquerade rule if it exists (idempotent)
    iptables -t nat -D POSTROUTING -s REDACTED_CIDR ! -d REDACTED_CIDR -j MASQUERADE 2>/dev/null || true
}

flush_stale_netavark_nat() {
    # After a reboot, containers get new IPs but iptables-restore loads old
    # netavark NAT rules pointing to dead IPs. Flush ALL netavark NAT chains
    # so Podman can recreate them cleanly when containers start.
    echo "Flushing stale netavark NAT chains..."
    for chain in $(iptables -t nat -L -n 2>/dev/null | grep "^Chain NETAVARK" | awk '{print $2}'); do
        iptables -t nat -F "$chain" 2>/dev/null || true
    done
}

start_firewall() {
    echo "Starting firewall..."

    flush_builtin_chains
    flush_stale_netavark_nat

    # Default policies
    iptables -P INPUT DROP
    iptables -P FORWARD DROP
    iptables -P OUTPUT ACCEPT

    # Enable route_localnet so Podman localhost port-forwarding works
    # (DNAT from 127.0.0.1:hostport -> container_ip:port requires this)
    sysctl -w net.ipv4.conf.all.route_localnet=1 >/dev/null 2>&1

    # Allow loopback
    iptables -A INPUT -i lo -j ACCEPT
    iptables -A OUTPUT -o lo -j ACCEPT

    # Allow established connections
    iptables -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

    # Allow TCP ports
{% for port in security.firewall.allowed_ports %}
    iptables -A INPUT -p tcp --dport {{ port }} -j ACCEPT
{% endfor %}

    # Allow ICMP (ping)
    iptables -A INPUT -p icmp --icmp-type echo-request -j ACCEPT

{% if security.squid.enabled | default(false) %}
    # Allow container traffic to Squid transparent proxy
    iptables -A INPUT -s REDACTED_CIDR -p tcp --dport 3128 -j ACCEPT
    iptables -A INPUT -s REDACTED_CIDR -p tcp --dport 3129 -j ACCEPT
{% endif %}

    # Drop everything else on INPUT
    iptables -A INPUT -j DROP

    # ---- FORWARD chain: allow container network traffic ----
    # Jump to netavark chain first (if it exists) for container port-forwarding
    iptables -A FORWARD -j NETAVARK_FORWARD 2>/dev/null || true
    # Allow established/related forwarded connections
    iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    # Allow containers (REDACTED_CIDR) to reach the internet
    iptables -A FORWARD -s REDACTED_CIDR -j ACCEPT
    # Allow return traffic to containers
    iptables -A FORWARD -d REDACTED_CIDR -j ACCEPT

    # NAT: masquerade container traffic going out
    iptables -t nat -A POSTROUTING -s REDACTED_CIDR ! -d REDACTED_CIDR -j MASQUERADE

{% if security.squid.enabled | default(false) %}
    # Squid transparent proxy: redirect container HTTP/HTTPS through Squid
    iptables -t nat -A PREROUTING -s REDACTED_CIDR -d REDACTED_CIDR -j RETURN
    iptables -t nat -A PREROUTING -s REDACTED_CIDR -d 127.0.0.0/8 -j RETURN
    iptables -t nat -A PREROUTING -s REDACTED_CIDR -p tcp --dport 80 -j REDIRECT --to-port 3128
    iptables -t nat -A PREROUTING -s REDACTED_CIDR -p tcp --dport 443 -j REDIRECT --to-port 3129
{% endif %}

    echo "Firewall started successfully"
}

stop_firewall() {
    echo "Stopping firewall..."

    flush_builtin_chains

    # Set default policies to ACCEPT
    iptables -P INPUT ACCEPT
    iptables -P FORWARD ACCEPT
    iptables -P OUTPUT ACCEPT

    echo "Firewall stopped"
}

status_firewall() {
    echo "Firewall status:"
    iptables -L -n -v --line-numbers
    echo ""
    echo "NAT rules:"
    iptables -t nat -L -n -v --line-numbers
}

case "$1" in
    start)
        start_firewall
        ;;
    stop)
        stop_firewall
        ;;
    restart)
        stop_firewall
        start_firewall
        ;;
    status)
        status_firewall
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
