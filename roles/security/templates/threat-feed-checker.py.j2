#!/usr/bin/env python3
"""Threat Intelligence Feed Checker -> Prometheus textfile collector.

Extracts unique outbound destination IPs from Tetragon tcp_connect events
in Loki, checks them against AbuseIPDB and CrowdSec local decisions,
and writes results as Prometheus metrics for node-exporter textfile collector.

Runs every 15 minutes via cron.
"""
import json, os, sys, time, urllib.request, urllib.error, urllib.parse, subprocess
from datetime import datetime, timedelta, timezone

# Configuration
LOKI_URL = "http://localhost:3200"
LOKI_ORG_ID = "enterprise"
ABUSEIPDB_KEY = os.environ.get("ABUSEIPDB_KEY", "{{ threat_feed_abuseipdb_key | default('') }}")
OUTPUT = "/opt/compose/textfile-collector/threat-intel.prom"
CACHE_FILE = "/opt/compose/textfile-collector/.threat-cache.json"

# Rate limits: AbuseIPDB free = 1000/day, check max 60 per run
MAX_CHECKS_PER_RUN = 60
ABUSE_THRESHOLD = 25  # confidence score threshold to flag as malicious

# Private/internal IP prefixes to skip
PRIVATE_PREFIXES = ("10.", "127.", "172.16.", "172.17.", "172.18.", "172.19.",
                    "172.20.", "172.21.", "172.22.", "172.23.", "172.24.",
                    "172.25.", "172.26.", "172.27.", "172.28.", "172.29.",
                    "172.30.", "172.31.", "192.168.", "0.0.0.0", "::1", "fd", "fe80")


def query_loki_tcp_connect_ips():
    """Extract unique destination IPs from Tetragon tcp_connect kprobe events in last 1h."""
    end_ns = int(time.time() * 1e9)
    start_ns = int((time.time() - 3600) * 1e9)

    query = '{job="tetragon",kprobe_func="tcp_connect"}'
    params = urllib.parse.urlencode({
        "query": query,
        "start": str(start_ns),
        "end": str(end_ns),
        "limit": "5000",
    })
    print(f"  Querying Loki: {query}")

    req = urllib.request.Request(
        f"{LOKI_URL}/loki/api/v1/query_range?{params}",
        headers={"X-Scope-OrgID": LOKI_ORG_ID}
    )

    try:
        resp = urllib.request.urlopen(req, timeout=30)
        data = json.loads(resp.read())
    except Exception as e:
        print(f"Loki query failed: {e}", file=sys.stderr)
        return {}

    ip_binaries = {}  # {ip: set(binaries)}
    for stream in data.get("data", {}).get("result", []):
        for ts, line in stream.get("values", []):
            try:
                event = json.loads(line)
                kprobe = event.get("process_kprobe", {})
                if kprobe.get("function_name") != "tcp_connect":
                    continue
                binary = kprobe.get("process", {}).get("binary", "unknown")
                for arg in kprobe.get("args", []):
                    sock = arg.get("sock_arg", {})
                    daddr = sock.get("daddr", "")
                    if daddr and not daddr.startswith(PRIVATE_PREFIXES):
                        if daddr not in ip_binaries:
                            ip_binaries[daddr] = set()
                        ip_binaries[daddr].add(binary)
            except (json.JSONDecodeError, KeyError):
                continue

    return ip_binaries


def load_cache():
    """Load cached IP reputation results."""
    try:
        with open(CACHE_FILE) as f:
            cache = json.load(f)
        # Expire entries older than 24h
        now = time.time()
        return {ip: data for ip, data in cache.items() if now - data.get("ts", 0) < 86400}
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_cache(cache):
    """Save IP reputation cache."""
    with open(CACHE_FILE, "w") as f:
        json.dump(cache, f)


def check_abuseipdb(ip):
    """Check a single IP against AbuseIPDB."""
    if not ABUSEIPDB_KEY:
        return None

    req = urllib.request.Request(
        f"https://api.abuseipdb.com/api/v2/check?ipAddress={ip}&maxAgeInDays=90",
        headers={
            "Key": ABUSEIPDB_KEY,
            "Accept": "application/json",
        }
    )

    try:
        resp = urllib.request.urlopen(req, timeout=10)
        data = json.loads(resp.read())["data"]
        return {
            "score": data.get("abuseConfidenceScore", 0),
            "reports": data.get("totalReports", 0),
            "country": data.get("countryCode", ""),
            "isp": data.get("isp", ""),
            "domain": data.get("domain", ""),
        }
    except Exception as e:
        print(f"AbuseIPDB check failed for {ip}: {e}", file=sys.stderr)
        return None


def check_crowdsec_local(ip):
    """Check IP against local CrowdSec decisions."""
    try:
        result = subprocess.run(
            ["podman", "exec", "crowdsec", "cscli", "decisions", "list", "-i", ip, "-o", "json"],
            capture_output=True, text=True, timeout=10
        )
        decisions = json.loads(result.stdout) if result.stdout.strip() else None
        if decisions and isinstance(decisions, list) and len(decisions) > 0:
            return {
                "banned": True,
                "reason": decisions[0].get("scenario", "unknown"),
            }
        return {"banned": False}
    except Exception:
        return {"banned": False}


def write_metrics(cache, ip_binaries, checked_count):
    """Write Prometheus metrics file."""
    total_ips = len(ip_binaries)
    lines = []

    lines.append("# HELP threat_intel_outbound_ips_total Total unique outbound IPs seen in last hour")
    lines.append("# TYPE threat_intel_outbound_ips_total gauge")
    lines.append(f"threat_intel_outbound_ips_total {total_ips}")

    lines.append("# HELP threat_intel_checked_ips_total IPs checked against threat feeds (cached)")
    lines.append("# TYPE threat_intel_checked_ips_total gauge")
    lines.append(f"threat_intel_checked_ips_total {checked_count}")

    # Count malicious IPs
    malicious = sum(1 for d in cache.values() if d.get("score", 0) >= ABUSE_THRESHOLD)
    lines.append("# HELP threat_intel_malicious_ips IPs with AbuseIPDB score >= threshold")
    lines.append("# TYPE threat_intel_malicious_ips gauge")
    lines.append(f"threat_intel_malicious_ips {malicious}")

    # Count CrowdSec banned IPs making outbound connections
    cs_banned = sum(1 for ip, d in cache.items()
                    if d.get("cs_banned", False) and ip in ip_binaries)
    lines.append("# HELP threat_intel_crowdsec_flagged_ips Outbound dest IPs also in CrowdSec ban list")
    lines.append("# TYPE threat_intel_crowdsec_flagged_ips gauge")
    lines.append(f"threat_intel_crowdsec_flagged_ips {cs_banned}")

    # Per-IP detail for flagged IPs (score > 0)
    lines.append("# HELP threat_intel_ip_abuse_score AbuseIPDB confidence score per IP")
    lines.append("# TYPE threat_intel_ip_abuse_score gauge")
    for ip, data in sorted(cache.items(), key=lambda x: x[1].get("score", 0), reverse=True):
        score = data.get("score", 0)
        if score > 0 and ip in ip_binaries:
            country = data.get("country", "")
            isp = data.get("isp", "").replace('"', "").replace("\\", "")[:50]
            binaries = ",".join(sorted(ip_binaries[ip]))[:80]
            lines.append(
                f'threat_intel_ip_abuse_score{{ip="{ip}",country="{country}",'
                f'isp="{isp}",binary="{binaries}"}} {score}'
            )

    # Outbound connections by binary (which processes are connecting externally)
    binary_counts = {}
    for ip, bins in ip_binaries.items():
        for b in bins:
            short = os.path.basename(b)
            binary_counts[short] = binary_counts.get(short, 0) + 1
    lines.append("# HELP threat_intel_outbound_by_binary Unique dest IPs per binary")
    lines.append("# TYPE threat_intel_outbound_by_binary gauge")
    for binary, count in sorted(binary_counts.items(), key=lambda x: -x[1]):
        lines.append(f'threat_intel_outbound_by_binary{{binary="{binary}"}} {count}')

    lines.append("# HELP threat_intel_last_run_timestamp Unix timestamp of last successful run")
    lines.append("# TYPE threat_intel_last_run_timestamp gauge")
    lines.append(f"threat_intel_last_run_timestamp {int(time.time())}")

    with open(OUTPUT, "w") as f:
        f.write("\n".join(lines) + "\n")


def main():
    print(f"[{datetime.now().isoformat()}] Threat feed checker starting")

    # 1. Get outbound IPs from Tetragon via Loki
    ip_binaries = query_loki_tcp_connect_ips()
    print(f"  Found {len(ip_binaries)} unique outbound IPs in last hour")

    # 2. Load cache
    cache = load_cache()

    # 3. Find IPs not yet checked
    new_ips = [ip for ip in ip_binaries if ip not in cache]
    to_check = new_ips[:MAX_CHECKS_PER_RUN]
    print(f"  {len(new_ips)} new IPs, checking {len(to_check)}")

    # 4. Check against feeds
    for ip in to_check:
        entry = {"ts": time.time()}

        # CrowdSec local check (free, no rate limit)
        cs = check_crowdsec_local(ip)
        entry["cs_banned"] = cs.get("banned", False)
        entry["cs_reason"] = cs.get("reason", "")

        # AbuseIPDB check (rate limited)
        abuse = check_abuseipdb(ip)
        if abuse:
            entry.update(abuse)

        cache[ip] = entry

        # Small delay to respect AbuseIPDB rate limits
        if ABUSEIPDB_KEY:
            time.sleep(0.5)

    # 5. Save cache
    save_cache(cache)

    # 6. Write metrics
    write_metrics(cache, ip_binaries, len(cache))
    print(f"  Wrote metrics to {OUTPUT}")
    flagged = sum(1 for d in cache.values() if d.get("score", 0) >= ABUSE_THRESHOLD)
    print(f"  Malicious IPs: {flagged}, CrowdSec banned: "
          f"{sum(1 for d in cache.values() if d.get('cs_banned', False))}")


if __name__ == "__main__":
    main()
