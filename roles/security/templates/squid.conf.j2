# Squid Transparent Proxy — {{ security.squid.mode | default('discovery') | capitalize }} Mode
# Generated by Ansible
{% if security.squid.mode | default('discovery') == 'discovery' %}
# Log all outbound container traffic, block nothing
{% else %}
# Whitelist-based blocking of outbound container traffic
{% endif %}
# Deployed on host (Alpine Linux) to intercept container egress

# === PORTS ===
# HTTP transparent interception
http_port {{ security.squid.http_port | default(3128) }} intercept

# HTTPS transparent interception (peek at SNI, splice through — no decryption)
https_port {{ security.squid.https_port | default(3129) }} intercept ssl-bump \
  cert=/etc/squid/ssl/squid-ca.pem \
  generate-host-certificates=on \
  dynamic_cert_mem_cache_size=4MB \
  tls-default-ca=off

sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/lib/squid/ssl_db -M 4MB

# === SSL BUMP — PEEK ONLY ===
# Step 1: Peek at ClientHello to read SNI (domain name)
# Step 2: Peek at server cert
# Step 3: Splice (pass through encrypted, no MITM)
acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl step3 at_step SslBump3
ssl_bump peek step1
ssl_bump peek step2
ssl_bump splice step3
ssl_bump splice all

# === ACLS ===
acl container_net src {{ security.squid.container_subnet | default('REDACTED_CIDR') }}
acl localhost src 127.0.0.0/8

# === ACCESS ===
{% if security.squid.mode | default('discovery') == 'discovery' %}
# Discovery mode: allow all (log-only)
http_access allow container_net
{% else %}
# Enforcement mode: whitelist-based
# TODO: Add whitelist ACLs here
http_access deny container_net
{% endif %}
http_access allow localhost
http_access deny all

# === LOGGING — DETAILED FOR DISCOVERY ===
logformat discovery %tl %6tr %>a %Ss/%03>Hs %<st %rm %ru %ssl::>sni %>rd %{User-Agent}>h
access_log stdio:/var/log/squid/access.log discovery

# Structured JSON format for parsing
logformat json {"timestamp":"%tl","src_ip":"%>a","method":"%rm","url":"%ru","sni":"%ssl::>sni","domain":"%>rd","status":"%>Hs","bytes":"%<st","duration_ms":"%6tr","hierarchy":"%Ss","content_type":"%mt","user_agent":"%{User-Agent}>h"}
access_log stdio:/var/log/squid/access-json.log json

# === CACHE — DISABLED (pure proxy) ===
cache deny all
cache_mem 8 MB

# === GENERAL ===
visible_hostname squid-{{ security.squid.mode | default('discovery') }}
forwarded_for on
httpd_suppress_version_string on

# Coredump directory
coredump_dir /var/cache/squid

# PID file
pid_filename /run/squid/squid.pid

# Run as squid user
cache_effective_user squid
cache_effective_group squid

# DNS — use host resolver
dns_nameservers {{ security.squid.dns_nameserver | default('REDACTED_DNS') }}

# Timeouts
connect_timeout 30 seconds
read_timeout 5 minutes
