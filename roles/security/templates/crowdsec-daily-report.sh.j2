#!/bin/sh
# CrowdSec Daily Threat Report — sends to Telegram group

BOT_TOKEN=$(podman exec telegram-gateway printenv TELEGRAM_BOT_TOKEN)
CHAT_ID="{{ telegram_group_chat_id | default('-5072915325') }}"
DASHBOARD_URL='https://grafana.{{ domain_name | default("REDACTED_DOMAIN") }}/d/crowdsec-threats/crowdsec-cyber-threat-insights?orgId=1&from=now-6h&to=now&timezone=browser&var-host=$__all&var-Filters=&refresh=5m'

# Get quick stats from CrowdSec (grep -c returns 0 on no match, which is valid)
ALERTS=$(podman exec crowdsec cscli alerts list -l 50 -o json 2>/dev/null | grep -c '"id"' 2>/dev/null) || ALERTS="N/A"
DECISIONS=$(podman exec crowdsec cscli decisions list -l 50 -o json 2>/dev/null | grep -c '"id"' 2>/dev/null) || DECISIONS="N/A"
BOUNCERS=$(podman exec crowdsec cscli bouncers list -o json 2>/dev/null | grep -c '"name"' 2>/dev/null) || BOUNCERS="N/A"

DATE=$(date "+%B %d, %Y %I:%M %p %Z")

# Build message with proper escaping for Telegram Markdown
MESSAGE=$(cat <<EOF
🛡️ *CrowdSec Daily Threat Report*
📅 ${DATE}

📊 *Quick Stats (last 50 entries):*
• Recent Alerts: ${ALERTS}
• Active Decisions (bans): ${DECISIONS}
• Active Bouncers: ${BOUNCERS}

🔗 *Live Dashboard:*
[CrowdSec Cyber Threat Insights](${DASHBOARD_URL})

_The dashboard shows real-time threat intelligence for AICORTEX infrastructure — blocked IPs, attack types (brute-force, scanning, credential stuffing), geographic origin of threats, and active CrowdSec decisions. The last 6 hours of data are displayed with auto-refresh._
EOF
)

# JSON-encode the message safely
JSON_TEXT=$(printf '%s' "$MESSAGE" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')

curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
  -H "Content-Type: application/json" \
  -d "{\"chat_id\": ${CHAT_ID}, \"text\": ${JSON_TEXT}, \"parse_mode\": \"Markdown\", \"disable_web_page_preview\": true}"
