type: http
name: http_default
log_level: info

# Push each CrowdSec decision to VictoriaMetrics as a time series with full geo/ASN labels.
# VictoriaMetrics /api/v1/import accepts JSON Lines (one JSON object per line).
format: >
  {% raw %}{{- range $Alert := . -}}{{- range .Decisions -}}{"metric":{"__name__":"cs_lapi_decision","instance":"{% endraw %}{{ ansible_hostname }}{% raw %}","country":"{{$Alert.Source.Cn}}","asname":"{{$Alert.Source.AsName}}","asnumber":"{{$Alert.Source.AsNumber}}","latitude":"{{$Alert.Source.Latitude}}","longitude":"{{$Alert.Source.Longitude}}","iprange":"{{$Alert.Source.Range}}","scenario":"{{.Scenario}}","type":"{{.Type}}","duration":"{{.Duration}}","scope":"{{.Scope}}","ip":"{{.Value}}"},"values":[1],"timestamps":[{{now|unixEpoch}}000]}
  {{- end }}{{- end -}}{% endraw %}

url: http://metrics-pod:8428/api/v1/import
method: POST
headers:
  Content-Type: application/json
timeout: 10s
