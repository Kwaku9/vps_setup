# GENERATED by tools/netseg from network/zones.yml and network/flows.yml.
# Do not edit by hand: run scripts/lint-zones.sh --update.
# INPUT half: what each zone bridge may reach on the host. Include it right after the INPUT
# ESTABLISHED,RELATED accept and BEFORE the allowed_ports loop: the template accepts tcp/22 from
# every interface, which would shadow these rules if they came later.
# Runs first, so it rebuilds the shared terminal chains before any rule jumps to them.
iptables -N ZONE_AUDIT 2>/dev/null || iptables -F ZONE_AUDIT
iptables -A ZONE_AUDIT -m limit --limit 20/min --limit-burst 50 -j LOG --log-prefix "zone-would-deny "
iptables -A ZONE_AUDIT -j ACCEPT
iptables -N ZONE_DENY 2>/dev/null || iptables -F ZONE_DENY
iptables -A ZONE_DENY -m limit --limit 20/min --limit-burst 50 -j LOG --log-prefix "zone-deny "
iptables -A ZONE_DENY -j DROP
# --- tunnel ---
iptables -A INPUT -i br-tunnel -s 10.89.128.2/32 -p tcp --dport 22 -m comment --comment "cloudflared-pod>host" -j ACCEPT
iptables -A INPUT -i br-tunnel -s 10.89.128.0/29 -p udp --dport 53 -j ACCEPT
iptables -A INPUT -i br-tunnel -s 10.89.128.0/29 -p tcp --dport 53 -j ACCEPT
iptables -A INPUT -i br-tunnel -p tcp --dport 22 -m comment --comment "tunnel>host-ssh-denied" -j ZONE_DENY
