# GENERATED by tools/netseg from network/zones.yml and network/flows.yml.
# Do not edit by hand: run scripts/lint-zones.sh --update.
# NAT half: egress MASQUERADE and the Squid intercept for zones. Include it after the legacy nat
# sections (it needs SQUID_ENABLED / SQUID_HTTP_PORT / SQUID_HTTPS_PORT set by the template).
iptables -t nat -N ZONE_POST 2>/dev/null || iptables -t nat -F ZONE_POST
iptables -t nat -N ZONE_PRE 2>/dev/null || iptables -t nat -F ZONE_PRE
iptables -t nat -N ZONE_PROXY 2>/dev/null || iptables -t nat -F ZONE_PROXY
# egress NAT, only for zones that have an internet or tailnet flow
iptables -t nat -A ZONE_POST -s 10.89.128.0/29 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.8/29 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.48/28 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.96/28 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.112/28 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.128/28 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.144/28 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.160/29 ! -d 10.89.0.0/16 -j MASQUERADE
iptables -t nat -A ZONE_POST -s 10.89.128.168/29 ! -d 10.89.0.0/16 -j MASQUERADE
# Squid transparent intercept, only for zones with an internet flow on 80/443
if [ "${SQUID_ENABLED:-0}" = 1 ]; then
    iptables -t nat -A ZONE_PROXY -d 0.0.0.0/8 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 10.0.0.0/8 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 100.64.0.0/10 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 127.0.0.0/8 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 169.254.0.0/16 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 172.16.0.0/12 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 192.168.0.0/16 -j RETURN
    iptables -t nat -A ZONE_PROXY -d 224.0.0.0/3 -j RETURN
    iptables -t nat -A ZONE_PROXY -p tcp --dport 80 -j REDIRECT --to-ports "${SQUID_HTTP_PORT:-3128}"
    iptables -t nat -A ZONE_PROXY -p tcp --dport 443 -j REDIRECT --to-ports "${SQUID_HTTPS_PORT:-3129}"
    iptables -t nat -A ZONE_PRE -i br-edge -s 10.89.128.8/29 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-svc -s 10.89.128.48/28 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-observe -s 10.89.128.96/28 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-agent -s 10.89.128.112/28 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-fintech -s 10.89.128.128/28 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-scrape -s 10.89.128.144/28 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-mgmt -s 10.89.128.160/29 -j ZONE_PROXY
    iptables -t nat -A ZONE_PRE -i br-mail -s 10.89.128.168/29 -j ZONE_PROXY
fi
# attach once: remove every earlier copy of the jump, then insert it first
while iptables -t nat -D PREROUTING -j ZONE_PRE 2>/dev/null; do :; done
iptables -t nat -I PREROUTING 1 -j ZONE_PRE
while iptables -t nat -D POSTROUTING -j ZONE_POST 2>/dev/null; do :; done
iptables -t nat -I POSTROUTING 1 -j ZONE_POST
