# Cloudflare Tunnel Configuration
# Generated by Ansible - {{ ansible_date_time.iso8601 | default('') }}
# Do not edit manually

tunnel: {{ cloudflare_tunnel.name }}
credentials-file: /etc/cloudflared/credentials.json

# Metrics endpoint for health checks
metrics: 0.0.0.0:{{ cloudflare_tunnel.metrics_port }}

# Transport protocol (quic is recommended for better performance)
protocol: {{ cloudflare_tunnel.protocol }}

# Disable auto-update (managed by container image version)
no-autoupdate: true

# Ingress rules - define how traffic is routed
ingress:
{% if cloudflare_tunnel.ingress | length > 0 %}
  # Custom ingress rules from configuration
{% for rule in cloudflare_tunnel.ingress %}
{% if rule.hostname is defined %}
  - hostname: "{{ rule.hostname }}"
    service: {{ rule.service }}
{% if rule.originRequest is defined %}
    originRequest:
{% if rule.originRequest.noTLSVerify is defined %}
      noTLSVerify: {{ rule.originRequest.noTLSVerify | lower }}
{% endif %}
{% if rule.originRequest.connectTimeout is defined %}
      connectTimeout: {{ rule.originRequest.connectTimeout }}
{% endif %}
{% endif %}
{% else %}
  # Catch-all rule (required)
  - service: {{ rule.service }}
{% endif %}
{% endfor %}
{% else %}
  # Default ingress rules - route all traffic through Traefik (HTTPS)
  # Using HTTPS to Traefik:443 to maintain TLS end-to-end.
  # noTLSVerify is needed because Traefik's ACME cert is for the public
  # domain, and cloudflared connects by container hostname.
  # Root domain
  - hostname: "{{ cf_domain }}"
    service: https://localhost:443
    originRequest:
      connectTimeout: 30s
      noTLSVerify: true

  # Wildcard subdomain
  - hostname: "*.{{ cf_domain }}"
    service: https://localhost:443
    originRequest:
      connectTimeout: 30s
      noTLSVerify: true

  # Catch-all rule (required - returns 404 for unmatched requests)
  - service: http_status:404
{% endif %}

# Origin server configuration
originRequest:
  # Timeout for establishing connection to origin
  connectTimeout: 30s
  # Keep-alive settings
  tcpKeepAlive: 30s
  # Disable TLS verification for internal services (they're behind the tunnel)
  noTLSVerify: false
  # HTTP/2 origin
  http2Origin: false
