# Traefik Dynamic Configuration - Service Routes
# Generated by Ansible - {{ ansible_date_time.iso8601 | default('') }}
# Subdomain routing: Cloudflare Tunnel -> Traefik -> Services
# Auth: Native OIDC per service (Grafana, Portainer, OpenWebUI handle their own)

http:
  routers:
{% for service in cloudflare_exposed_services %}
{% if service.enabled | default(true) | bool %}
    # {{ service.name | title }} Router
    {{ service.name }}:
      rule: "Host(`{{ service.host }}`)"
      entryPoints:
        - websecure
      service: {{ service.name }}
{% if service.tls | default(true) | bool %}
      tls:
        certResolver: cloudflare
{% endif %}
{% set base_mw = service.middlewares | default(traefik_default_middlewares | default([])) %}
{% set mw_list = (['crowdsec'] + base_mw) if (security.crowdsec.enabled | default(false) and 'crowdsec' not in base_mw) else base_mw %}
{% if mw_list | length > 0 %}
      middlewares:
{% for mw in mw_list %}
        - {{ mw }}
{% endfor %}
{% endif %}

{% endif %}
{% endfor %}

  services:
{% for service in cloudflare_exposed_services %}
{% if service.enabled | default(true) | bool %}
    # {{ service.name | title }} Service
    {{ service.name }}:
      loadBalancer:
        servers:
          - url: "{{ service.service_url }}"
{% if service.tls_skip_verify | default(false) | bool %}
        serversTransport: skipVerify
{% endif %}

{% endif %}
{% endfor %}

  # Middlewares
  middlewares:
    # IPAllowList — only Podman enterprise_network and localhost
    # Cloudflare Tunnel traffic arrives from cloudflared container on REDACTED_CIDR
    internal-only:
      ipAllowList:
        sourceRange:
          - "REDACTED_CIDR"
          - "127.0.0.0/8"

    # Security headers
    secure-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        frameDeny: true
        sslRedirect: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        customFrameOptionsValue: "SAMEORIGIN"

    # Rate limiting
    rate-limit:
      rateLimit:
        average: 100
        burst: 50
        period: 1m

    # Compress responses
    compress:
      compress: {}

{% if security.crowdsec.enabled | default(false) %}
    # CrowdSec bouncer — blocks IPs flagged by CrowdSec engine
    crowdsec:
      plugin:
        crowdsec-bouncer:
          enabled: true
          crowdsecLapiScheme: http
          crowdsecLapiHost: "localhost:8180"
          crowdsecLapiKey: "{{ crowdsec_bouncer_api_key | default('') }}"
          forwardedHeadersTrustedIPs:
            - "REDACTED_CIDR"
            - "127.0.0.0/8"
{% endif %}

# Server transports (for services with self-signed certs)
  serversTransports:
    skipVerify:
      insecureSkipVerify: true
