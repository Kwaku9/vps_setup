# Traefik Static Configuration with ACME (Let's Encrypt)
# Generated by Ansible - {{ ansible_date_time.iso8601 | default('') }}
# Cloudflare DNS Challenge for wildcard certificates

global:
  checkNewVersion: false
  sendAnonymousUsage: false

api:
  dashboard: true
  insecure: false  # Dashboard accessible via traefik.domain.com (internal services have own auth)

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
    http:
      tls:
        certResolver: cloudflare
{% if cloudflare_traefik.domains | length > 0 %}
        domains:
{% for domain in cloudflare_traefik.domains %}
          - main: "{{ domain.main }}"
{% if domain.sans is defined and domain.sans | length > 0 %}
            sans:
{% for san in domain.sans %}
              - "{{ san }}"
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# Certificate Resolvers
certificatesResolvers:
  cloudflare:
    acme:
      email: {{ cf_email }}
      storage: {{ cloudflare_traefik.acme.storage }}
      caServer: {{ cloudflare_traefik.acme.ca_server }}
      dnsChallenge:
        provider: cloudflare
        delayBeforeCheck: {{ cloudflare_traefik.acme.dns_challenge.delay_before_check }}
        resolvers:
{% for resolver in cloudflare_traefik.acme.dns_challenge.resolvers %}
          - "{{ resolver }}"
{% endfor %}

{% if security.crowdsec.enabled | default(false) %}
experimental:
  plugins:
    crowdsec-bouncer:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      version: "v1.3.5"
{% endif %}

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: {{ cloudflare_network }}

  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: INFO
  format: json

accessLog:
  format: json
  fields:
    headers:
      names:
        X-Forwarded-For: keep
        Cf-Connecting-Ip: keep
        Cf-Ray: keep
        User-Agent: keep

# Metrics (Prometheus)
metrics:
  prometheus:
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true

# OpenTelemetry distributed tracing — generates spans for every proxied request
# Includes cf-ray header as span attribute for Cloudflare edge correlation
tracing:
  otlp:
    http:
      endpoint: "http://logs-pod:4318/v1/traces"
