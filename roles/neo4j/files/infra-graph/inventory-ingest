#!/usr/bin/env python3
"""Receive an inventory snapshot from another machine over SSH.

    ssh <vps> inventory-ingest fedora < snapshot.json

The laptop cannot be reached from here (tailnet policy), so it pushes. SSH is
the authentication: no token lives on the laptop. The snapshot is validated
and stored as /opt/compose/infra-graph/inventory/<host>.json (0600), which the
infra-graph collector loads as its `remote` source on its next run.
"""
import json
import os
import re
import sys
import time

DIR = os.environ.get("INVENTORY_DIR", "/opt/compose/infra-graph/inventory")
MAX_BYTES = 5 * 1024 * 1024
LISTS = ("repos", "pipelines", "timers", "cron", "ports", "containers")


def fail(msg):
    print(f"inventory-ingest: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    if len(sys.argv) != 2 or not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", sys.argv[1]):
        fail("usage: inventory-ingest <host>   (host: lowercase letters, digits, dashes)")
    host = sys.argv[1]
    raw = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        fail(f"snapshot larger than {MAX_BYTES} bytes")
    try:
        doc = json.loads(raw)
    except ValueError as exc:
        fail(f"not JSON: {exc}")
    if not isinstance(doc, dict) or doc.get("host") != host:
        fail(f"snapshot is for {doc.get('host') if isinstance(doc, dict) else '?'!r}, not {host!r}")
    for key in LISTS:
        if not isinstance(doc.get(key, []), list):
            fail(f"{key} must be a list")
    doc["received_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    path = os.path.join(DIR, f"{host}.json")
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(doc, fh)
    os.replace(tmp, path)
    print(f"stored {host}: " + ", ".join(f"{len(doc.get(k, []))} {k}" for k in LISTS))


if __name__ == "__main__":
    main()
