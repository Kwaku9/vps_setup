# Prometheus Alert Rules
# Critical service health alerts — visible in Prometheus UI and Grafana
# Notification delivery requires Alertmanager configuration (out of scope)
# Generated by Ansible

groups:
  - name: service_health
    rules:
      - alert: TargetDown
        expr: up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}{{ $labels.job }}{% endraw %} target is down"
          description: "{% raw %}{{ $labels.instance }}{% endraw %} has been unreachable for 2 minutes."

      - alert: PrometheusTargetMissing
        expr: absent(up{job="litellm"}) or absent(up{job="traefik"}) or absent(up{job="authentik"})
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "A critical Prometheus scrape target is missing"

  - name: infrastructure
    rules:
      - alert: HighCpuUsage
        expr: instance:node_cpu_utilisation:ratio > 0.85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "CPU usage above 85%"
          description: "{% raw %}CPU at {{ $value | humanizePercentage }}{% endraw %} for 5 minutes."

      - alert: HighMemoryUsage
        expr: instance:node_memory_utilisation:ratio > 0.90
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Memory usage above 90%"
          description: "{% raw %}Memory at {{ $value | humanizePercentage }}{% endraw %} for 5 minutes."

      - alert: DiskSpaceLow
        expr: instance:node_filesystem_utilisation:ratio > 0.85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Disk usage above 85% on {{ $labels.mountpoint }}{% endraw %}"

      - alert: DiskSpaceCritical
        expr: instance:node_filesystem_utilisation:ratio > 0.95
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}Disk usage above 95% on {{ $labels.mountpoint }}{% endraw %}"

  - name: ai_stack
    rules:
      - alert: LiteLLMHighErrorRate
        expr: litellm:error_ratio:ratio5m > 0.05
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "LiteLLM error rate above 5%"
          description: "{% raw %}Error ratio at {{ $value | humanizePercentage }}{% endraw %}."

      - alert: LiteLLMHighLatency
        expr: histogram_quantile(0.95, sum(rate(litellm_request_duration_metric_bucket[5m]))) > 30
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "LiteLLM P95 latency above 30 seconds"

  - name: ingress
    rules:
      - alert: CloudflareTunnelDown
        expr: absent(cloudflared_tunnel_ha_connections) or cloudflared_tunnel_ha_connections < 1
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Cloudflare tunnel has no HA connections"

      - alert: TraefikHighErrorRate
        expr: sum(rate(traefik_service_requests_total{code=~"5.."}[5m])) / clamp_min(traefik:requests:rate5m, 0.001) > 0.05
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Traefik 5xx error rate above 5%"

  # wazuh and checkmk alert groups removed — both intentionally down

  - name: user_spend
    rules:
      - alert: HighUserSpend
        expr: user:litellm_spend:total > 50
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}User {{ $labels.end_user }} has spent over $50{% endraw %}"
          description: "{% raw %}Total spend: ${{ $value | humanize }}{% endraw %}"

  - name: openwebui
    rules:
      - alert: OpenWebUIUnhealthy
        expr: up{job="openwebui"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "OpenWebUI is unhealthy or unreachable"

  - name: alloy
    rules:
      - alert: AlloyOTELExportFailures
        expr: rate(otelcol_exporter_send_failed_spans_total[5m]) > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Alloy OTEL exporter is failing to send spans"
          description: "{% raw %}Failed span rate: {{ $value | humanize }}/s{% endraw %}"

  - name: security_threats
    rules:
      - alert: High4xxRate
        expr: >
          sum(rate(traefik_service_requests_total{code=~"4.."}[5m]))
          /
          clamp_min(sum(rate(traefik_service_requests_total[5m])), 0.001)
          > 0.30
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High 4xx rate detected — possible scanning"
          description: "{% raw %}4xx ratio at {{ $value | humanizePercentage }} for 5 minutes. May indicate reconnaissance or credential stuffing.{% endraw %}"

      - alert: TrafficSpike
        expr: >
          sum(rate(traefik_entrypoint_requests_total[3m]))
          >
          10 * avg_over_time(sum(rate(traefik_entrypoint_requests_total[5m]))[1h:5m])
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Traffic spike — 10x normal rate"
          description: "{% raw %}Current rate is {{ $value | humanize }}req/s, 10x the hourly average. Possible DDoS or bot flood.{% endraw %}"

      - alert: Traefik5xxSpike
        expr: >
          sum(rate(traefik_service_requests_total{code=~"5.."}[3m]))
          /
          clamp_min(sum(rate(traefik_service_requests_total[3m])), 0.001)
          > 0.10
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "5xx error spike — backend failures"
          description: "{% raw %}5xx ratio at {{ $value | humanizePercentage }} for 3 minutes. May indicate attack or backend degradation.{% endraw %}"
