#!/bin/sh
# Dependency Health Monitor — runs every 2 minutes via cron
# Checks service dependencies, Traefik middleware errors, pushes metrics to VictoriaMetrics
# Sends Telegram alerts on state transitions (OK->FAIL or FAIL->OK)
# Generated by Ansible

set -u

VM_URL="http://localhost:8428/api/v1/import/prometheus"
STATE_FILE="/tmp/dep-health-state"
METRICS=""
FAILURES=""
RECOVERIES=""

# -- helpers --

add_metric() {
    METRICS="${METRICS}${1}\n"
}

check_state_change() {
    local key="$1" new_bad="$2" desc="$3"
    local prev_bad=""

    if [ -f "$STATE_FILE" ]; then
        prev_bad=$(grep "^${key}=" "$STATE_FILE" 2>/dev/null | cut -d= -f2 | head -1)
    fi

    if [ "$new_bad" = "1" ] && [ "$prev_bad" != "1" ]; then
        FAILURES="${FAILURES}  * ${desc}\n"
    fi
    if [ "$new_bad" = "0" ] && [ "$prev_bad" = "1" ]; then
        RECOVERIES="${RECOVERIES}  * ${desc}\n"
    fi
}

# -- Container checks --

check_container() {
    local name="$1" role="$2" depends_on="${3:-none}"
    local running=0

    if podman ps --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null | grep -qx "$name"; then
        running=1
    fi

    add_metric "dep_container_up{container=\"$name\",role=\"$role\",depends_on=\"$depends_on\"} $running"

    local bad=0
    [ "$running" = "0" ] && bad=1
    check_state_change "ctr_${name}" "$bad" "Container ${name} ($role) $([ $bad = 1 ] && echo DOWN || echo RECOVERED)"
}

# -- TCP port checks --

check_tcp() {
    local host="$1" port="$2" service="$3"
    local reachable=0

    if nc -z -w3 "$host" "$port" 2>/dev/null; then
        reachable=1
    fi

    add_metric "dep_tcp_reachable{host=\"$host\",port=\"$port\",service=\"$service\"} $reachable"

    local bad=0
    [ "$reachable" = "0" ] && bad=1
    check_state_change "tcp_${host}_${port}" "$bad" "TCP $service ($host:$port) $([ $bad = 1 ] && echo UNREACHABLE || echo RECOVERED)"
}

# -- HTTP health endpoint checks --

check_http() {
    local url="$1" service="$2" expected_code="${3:-200}"
    local status_code latency_ms healthy=0

    local result
    result=$(curl -so /dev/null -w '%{http_code} %{time_total}' --connect-timeout 5 --max-time 10 "$url" 2>/dev/null)
    status_code=$(echo "$result" | awk '{print $1}')
    latency_ms=$(echo "$result" | awk '{printf "%.0f", $2 * 1000}')

    [ "$status_code" = "$expected_code" ] && healthy=1

    add_metric "dep_http_healthy{service=\"$service\"} $healthy"
    add_metric "dep_http_status_code{service=\"$service\"} $status_code"
    add_metric "dep_http_latency_ms{service=\"$service\"} $latency_ms"

    local bad=0
    [ "$healthy" = "0" ] && bad=1
    check_state_change "http_${service}" "$bad" "HTTP $service (code=$status_code) $([ $bad = 1 ] && echo UNHEALTHY || echo RECOVERED)"
}

# -- Traefik log monitoring --

check_traefik_logs() {
    local recent_logs
    recent_logs=$(podman logs traefik --since 300s 2>&1)

    local middleware_invalid plugin_errors log_errors
    middleware_invalid=$(echo "$recent_logs" | grep -c "invalid middleware" || echo 0)
    plugin_errors=$(echo "$recent_logs" | grep -c "Plugins are disabled\|unable to.*plugin\|validateParams" || echo 0)
    log_errors=$(echo "$recent_logs" | grep -c '"level":"error"' || echo 0)

    add_metric "dep_traefik_middleware_invalid $middleware_invalid"
    add_metric "dep_traefik_plugin_errors $plugin_errors"
    add_metric "dep_traefik_log_errors $log_errors"

    local mw_bad=0 pl_bad=0
    [ "$middleware_invalid" -gt 0 ] 2>/dev/null && mw_bad=1
    [ "$plugin_errors" -gt 0 ] 2>/dev/null && pl_bad=1

    check_state_change "traefik_middleware" "$mw_bad" "Traefik middleware: ${middleware_invalid} invalid errors $([ $mw_bad = 1 ] && echo DETECTED || echo CLEARED)"
    check_state_change "traefik_plugin" "$pl_bad" "Traefik plugin: ${plugin_errors} errors $([ $pl_bad = 1 ] && echo DETECTED || echo CLEARED)"
}

# -- Dependency chain checks --

check_chain() {
    local chain_name="$1"
    shift
    local all_ok=1
    local broken_link=""

    for component in "$@"; do
        local comp_name comp_type comp_target ok=0
        comp_name=$(echo "$component" | cut -d: -f1)
        comp_type=$(echo "$component" | cut -d: -f2)
        comp_target=$(echo "$component" | cut -d: -f3)

        case "$comp_type" in
            container)
                podman ps --format '{{ '{{' }}.Names{{ '}}' }}' 2>/dev/null | grep -qx "$comp_target" && ok=1
                ;;
            tcp)
                local h p
                h=$(echo "$comp_target" | cut -d/ -f1)
                p=$(echo "$comp_target" | cut -d/ -f2)
                nc -z -w2 "$h" "$p" 2>/dev/null && ok=1
                ;;
        esac

        if [ "$ok" = "0" ]; then
            all_ok=0
            broken_link="$comp_name"
            break
        fi
    done

    add_metric "dep_chain_healthy{chain=\"$chain_name\"} $all_ok"
    if [ "$all_ok" = "0" ]; then
        add_metric "dep_chain_broken_at{chain=\"$chain_name\",component=\"$broken_link\"} 1"
        check_state_change "chain_${chain_name}" "1" "Chain $chain_name BROKEN at $broken_link"
    else
        check_state_change "chain_${chain_name}" "0" "Chain $chain_name RECOVERED"
    fi
}

# ====================================================================
# MAIN
# ====================================================================

# -- Critical containers --
check_container "cloudflared"        "tunnel"     "cloudflare-api"
check_container "traefik"            "proxy"      "cloudflared"
check_container "crowdsec"           "security"   "none"
check_container "authentik-server"   "auth"       "authentik-postgres,redis"
check_container "authentik-worker"   "auth"       "authentik-postgres,redis"
check_container "authentik-postgres" "database"   "none"
check_container "redis"              "cache"      "none"
check_container "grafana"            "monitoring" "victoriametrics,loki,postgres"
check_container "loki"               "logging"    "none"
check_container "postgres"           "database"   "none"
check_container "open-webui"         "ai"         "ai-stack-postgres,litellm"
check_container "litellm"            "ai"         "ai-stack-postgres"
check_container "ai-stack-postgres"  "database"   "none"
check_container "portainer"          "management" "none"
check_container "nginx"              "frontend"   "none"
check_container "podman-exporter"    "monitoring" "none"
check_container "victoriametrics"    "monitoring" "none"

# -- TCP connectivity --
check_tcp "localhost" "443"  "traefik-https"
check_tcp "localhost" "5432" "enterprise-postgres"
check_tcp "localhost" "6379" "redis"
check_tcp "localhost" "3000" "grafana"
check_tcp "localhost" "8428" "victoriametrics"

# -- HTTP health endpoints --
check_http "http://localhost:3000/api/health"  "grafana"
check_http "http://localhost:8428/health"      "victoriametrics"
check_http "http://localhost:3200/ready"       "loki"

# -- Traefik log monitoring --
check_traefik_logs

# -- Dependency chains --
check_chain "web-to-grafana" \
    "cloudflared:container:cloudflared" \
    "traefik:container:traefik" \
    "grafana:container:grafana" \
    "victoriametrics:tcp:localhost/8428"

check_chain "web-to-chat" \
    "cloudflared:container:cloudflared" \
    "traefik:container:traefik" \
    "open-webui:container:open-webui" \
    "litellm:container:litellm" \
    "ai-postgres:container:ai-stack-postgres"

check_chain "web-to-auth" \
    "cloudflared:container:cloudflared" \
    "traefik:container:traefik" \
    "authentik:container:authentik-server" \
    "auth-postgres:container:authentik-postgres" \
    "redis:container:redis"

check_chain "web-to-portainer" \
    "cloudflared:container:cloudflared" \
    "traefik:container:traefik" \
    "portainer:container:portainer"

# -- Push metrics to VictoriaMetrics --
printf '%b' "$METRICS" | curl -s --data-binary @- "$VM_URL" 2>/dev/null

# -- Save state for next run --
{
    printf '%b' "$METRICS" | grep 'dep_container_up' | while IFS= read -r line; do
        cname=$(echo "$line" | sed -n 's/.*container="\([^"]*\)".*/\1/p')
        val=$(echo "$line" | awk '{print $NF}')
        bad=0; [ "$val" = "0" ] && bad=1
        echo "ctr_${cname}=${bad}"
    done
    printf '%b' "$METRICS" | grep 'dep_tcp_reachable' | while IFS= read -r line; do
        host=$(echo "$line" | sed -n 's/.*host="\([^"]*\)".*/\1/p')
        port=$(echo "$line" | sed -n 's/.*port="\([^"]*\)".*/\1/p')
        val=$(echo "$line" | awk '{print $NF}')
        bad=0; [ "$val" = "0" ] && bad=1
        echo "tcp_${host}_${port}=${bad}"
    done
    printf '%b' "$METRICS" | grep 'dep_http_healthy' | while IFS= read -r line; do
        svc=$(echo "$line" | sed -n 's/.*service="\([^"]*\)".*/\1/p')
        val=$(echo "$line" | awk '{print $NF}')
        bad=0; [ "$val" = "0" ] && bad=1
        echo "http_${svc}=${bad}"
    done
    printf '%b' "$METRICS" | grep 'dep_traefik_middleware_invalid ' | while IFS= read -r line; do
        val=$(echo "$line" | awk '{print $NF}')
        bad=0; [ "$val" -gt 0 ] 2>/dev/null && bad=1
        echo "traefik_middleware=${bad}"
    done
    printf '%b' "$METRICS" | grep 'dep_traefik_plugin_errors ' | while IFS= read -r line; do
        val=$(echo "$line" | awk '{print $NF}')
        bad=0; [ "$val" -gt 0 ] 2>/dev/null && bad=1
        echo "traefik_plugin=${bad}"
    done
    printf '%b' "$METRICS" | grep 'dep_chain_healthy' | while IFS= read -r line; do
        chain=$(echo "$line" | sed -n 's/.*chain="\([^"]*\)".*/\1/p')
        val=$(echo "$line" | awk '{print $NF}')
        bad=0; [ "$val" = "0" ] && bad=1
        echo "chain_${chain}=${bad}"
    done
} > "${STATE_FILE}.new"
mv "${STATE_FILE}.new" "$STATE_FILE" 2>/dev/null

# -- Send Telegram alerts on state changes --
if [ -n "$FAILURES" ] || [ -n "$RECOVERIES" ]; then
    MSG="<b>Dependency Alert</b>"
    if [ -n "$FAILURES" ]; then
        MSG="${MSG}\n\n<b>Failures:</b>\n<pre>$(printf '%b' "$FAILURES")</pre>"
    fi
    if [ -n "$RECOVERIES" ]; then
        MSG="${MSG}\n\n<b>Recoveries:</b>\n<pre>$(printf '%b' "$RECOVERIES")</pre>"
    fi
    MSG="${MSG}\n<i>$(date '+%Y-%m-%d %H:%M:%S %Z')</i>"
    /usr/local/bin/telegram-notify "$(printf '%b' "$MSG")" "HTML" 2>/dev/null || true
fi
