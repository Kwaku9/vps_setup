---
# Grafana Tempo Configuration
# Generated by Ansible
# Pod: tempo-pod (isolated from metrics-pod)

multitenancy_enabled: true

server:
  http_listen_port: 3200
  grpc_listen_port: 9095

distributor:
  receivers:
    otlp:
      protocols:
        http:
          endpoint: "0.0.0.0:4320"  # Internal only — Alloy forwards here (4318 used by Alloy OTLP gateway)

ingester:
  max_block_duration: 5m
  max_block_bytes: 5242880  # 5MB — flush blocks before they grow too large

compactor:
  compaction:
    block_retention: {{ monitoring.tempo.retention | default('168h') }}  # 7 days default

metrics_generator:
  registry:
    external_labels:
      source: tempo
      cluster: {{ monitoring.tempo.cluster_name | default('alpine-podman') }}
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://metrics-pod:8428/api/v1/write
        send_exemplars: true

storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

overrides:
  metrics_generator_processors: [service-graphs, span-metrics]
  ingestion_rate_limit_bytes: 5000000   # 5MB/s
  ingestion_burst_size_bytes: 10000000  # 10MB burst
  max_traces_per_user: 10000

usage_report:
  reporting_enabled: false
