# Prometheus Configuration
# Generated by Ansible

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: 'alpine-podman'
    environment: 'production'

alerting:
  alertmanagers:
    - static_configs:
        - targets: []

rule_files: []

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node-exporter'
    static_configs:
      - targets: ['localhost:9100']
        labels:
          instance: '{{ ansible_hostname }}'

  - job_name: 'cadvisor'
    static_configs:
      - targets: ['localhost:8080']
        labels:
          instance: '{{ ansible_hostname }}'

  - job_name: 'podman-containers'
    static_configs:
      - targets: []
