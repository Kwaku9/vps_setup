# VictoriaMetrics Scrape Configuration
# Generated by Ansible
# Pod: metrics-pod — targets updated for split monitoring architecture

global:
  scrape_interval: 30s
  external_labels:
    cluster: 'alpine-podman'
    environment: 'production'

scrape_configs:
  - job_name: 'victoriametrics'
    scrape_interval: 60s
    static_configs:
      - targets: ['localhost:8428']
        labels:
          component: 'victoriametrics'

  - job_name: 'node-exporter'
    scrape_interval: 30s
    static_configs:
      - targets: ['node-exporter-pod:9100']
        labels:
          instance: '{{ ansible_facts["hostname"] }}'
          component: 'node-exporter'

  - job_name: 'loki'
    scrape_interval: 60s
    static_configs:
      - targets: ['logs-pod:3100']
        labels:
          component: 'loki'

  - job_name: 'grafana'
    scrape_interval: 60s
    static_configs:
      - targets: ['localhost:3000']
        labels:
          component: 'grafana'

  - job_name: 'podman-exporter'
    scrape_interval: 60s
    static_configs:
      - targets: ['podman-exporter-pod:9882']
        labels:
          instance: '{{ ansible_facts["hostname"] }}'
          component: 'podman-exporter'

  - job_name: 'traefik'
    scrape_interval: 30s
    static_configs:
      - targets: ['security-infra-pod:8080']
        labels:
          component: 'traefik'

  - job_name: 'litellm'
    scrape_interval: 60s
    metrics_path: /metrics/
    static_configs:
      - targets: ['ai-stack-pod:4000']
        labels:
          component: 'litellm'

  - job_name: 'authentik'
    scrape_interval: 60s
    static_configs:
      - targets: ['authentication-pod:9300']
        labels:
          component: 'authentik'

  - job_name: 'crowdsec'
    scrape_interval: 60s
    static_configs:
      - targets: ['security-infra-pod:6060']
        labels:
          component: 'crowdsec'

  - job_name: 'cloudflared'
    scrape_interval: 60s
    static_configs:
      - targets: ['security-infra-pod:2000']
        labels:
          component: 'cloudflared'
