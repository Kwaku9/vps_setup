# Prometheus Recording Rules
# Pre-compute expensive queries used by Grafana dashboards
# Generated by Ansible

groups:
  - name: node_metrics
    interval: 30s
    rules:
      - record: instance:node_cpu_utilisation:ratio
        expr: 1 - avg without(cpu,mode) (rate(node_cpu_seconds_total{mode="idle"}[5m]))

      - record: instance:node_memory_utilisation:ratio
        expr: 1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)

      - record: instance:node_filesystem_utilisation:ratio
        expr: 1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay"} / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"})

      - record: instance:node_network_receive_bytes:rate5m
        expr: rate(node_network_receive_bytes_total{device!~"lo|veth.*|cali.*"}[5m])

      - record: instance:node_network_transmit_bytes:rate5m
        expr: rate(node_network_transmit_bytes_total{device!~"lo|veth.*|cali.*"}[5m])

  - name: litellm_metrics
    interval: 30s
    rules:
      - record: litellm:requests:rate5m
        expr: sum(rate(litellm_requests_metric_total[5m]))

      - record: litellm:request_errors:rate5m
        expr: sum(rate(litellm_requests_metric_total{status_code!~"2.."}[5m]))

      - record: litellm:error_ratio:ratio5m
        expr: litellm:request_errors:rate5m / clamp_min(litellm:requests:rate5m, 1)

      - record: model:litellm_latency:p95_5m
        expr: histogram_quantile(0.95, sum by(le, model) (rate(litellm_request_duration_metric_bucket[5m])))

      - record: model:litellm_tokens:rate5m
        expr: sum by(model) (rate(litellm_tokens_metric_total[5m]))

  - name: provider_comparison
    interval: 30s
    rules:
      # Extract provider prefix from model name (e.g., "openai/gpt-4" → "openai")
      - record: provider:litellm_latency:p95_5m
        expr: >
          histogram_quantile(0.95,
            sum by(le, api_provider) (
              rate(litellm_request_duration_metric_bucket[5m])
            )
          )

      - record: provider:litellm_requests:rate5m
        expr: sum by(api_provider) (rate(litellm_requests_metric_total[5m]))

      - record: provider:litellm_errors:rate5m
        expr: sum by(api_provider) (rate(litellm_requests_metric_total{status_code!~"2.."}[5m]))

      - record: provider:litellm_error_ratio:ratio5m
        expr: >
          provider:litellm_errors:rate5m
          / clamp_min(provider:litellm_requests:rate5m, 0.001)

      - record: provider:litellm_tokens:rate5m
        expr: sum by(api_provider) (rate(litellm_tokens_metric_total[5m]))

  - name: user_metrics
    interval: 30s
    rules:
      - record: user:litellm_requests:rate5m
        expr: sum by(end_user) (rate(litellm_requests_metric_total[5m]))

      - record: user:litellm_spend:total
        expr: sum by(end_user) (litellm_spend_metric_total)

      - record: user:litellm_tokens:total
        expr: sum by(end_user) (litellm_tokens_metric_total)

  - name: container_metrics
    interval: 30s
    rules:
      # Join name/pod_name labels from podman_container_info (value=1) onto resource metrics
      # Excludes pod infra containers (pause containers)
      - record: container:cpu_usage:rate5m
        expr: >
          rate(podman_container_cpu_seconds_total[5m])
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:memory_usage:bytes
        expr: >
          podman_container_mem_usage_bytes
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:memory_limit:bytes
        expr: >
          podman_container_mem_limit_bytes
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:memory_utilisation:ratio
        expr: >
          container:memory_usage:bytes
          / clamp_min(container:memory_limit:bytes, 1)

      - record: container:net_input:rate5m
        expr: >
          rate(podman_container_net_input_total[5m])
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:net_output:rate5m
        expr: >
          rate(podman_container_net_output_total[5m])
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:block_input:rate5m
        expr: >
          rate(podman_container_block_input_total[5m])
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:block_output:rate5m
        expr: >
          rate(podman_container_block_output_total[5m])
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

      - record: container:pids:current
        expr: >
          podman_container_pids
          * on(id) group_left(name, pod_name, image)
          podman_container_info{name!~".*-infra"}

  - name: traefik_metrics
    interval: 30s
    rules:
      - record: traefik:requests:rate5m
        expr: sum(rate(traefik_service_requests_total[5m]))

      - record: service:traefik_requests:rate5m
        expr: sum by(service) (rate(traefik_service_requests_total[5m]))

      - record: service:traefik_latency:p95_5m
        expr: histogram_quantile(0.95, sum by(le, service) (rate(traefik_service_request_duration_seconds_bucket[5m])))
