{
  "id": null,
  "uid": "trivy-vulnerabilities",
  "title": "Trivy Container Vulnerabilities",
  "description": "Container image vulnerability scan results from daily Trivy scans",
  "tags": ["security", "trivy", "vulnerabilities"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": { "from": "now-2d", "to": "now" },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total CRITICAL",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_vulnerabilities_total{severity=\"CRITICAL\"}",
          "legendFormat": "CRITICAL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    },
    {
      "id": 2,
      "title": "Total HIGH",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_vulnerabilities_total{severity=\"HIGH\"}",
          "legendFormat": "HIGH",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    },
    {
      "id": 3,
      "title": "Total MEDIUM",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_vulnerabilities_total{severity=\"MEDIUM\"}",
          "legendFormat": "MEDIUM",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Total LOW",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_vulnerabilities_total{severity=\"LOW\"}",
          "legendFormat": "LOW",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "super-light-blue", "value": 100 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Images Scanned",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_images_scanned",
          "legendFormat": "Images",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "Images with CRITICAL",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_images_with_critical",
          "legendFormat": "Critical Images",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Vulnerabilities by Image",
      "type": "row"
    },
    {
      "id": 10,
      "title": "CRITICAL Vulnerabilities by Image",
      "type": "bargauge",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sort_desc(trivy_vulnerability_count{severity=\"CRITICAL\"} > 0)",
          "legendFormat": "{{image}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" },
          "min": 0
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 11,
      "title": "HIGH Vulnerabilities by Image",
      "type": "bargauge",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "topk(15, trivy_vulnerability_count{severity=\"HIGH\"})",
          "legendFormat": "{{image}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "super-light-yellow", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "color": { "mode": "thresholds" },
          "min": 0
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Full Breakdown",
      "type": "row"
    },
    {
      "id": 20,
      "title": "All Vulnerabilities by Image & Severity",
      "type": "table",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_vulnerability_count{severity=\"CRITICAL\"}",
          "legendFormat": "{{image}}",
          "instant": true,
          "refId": "CRITICAL",
          "format": "table"
        },
        {
          "expr": "trivy_vulnerability_count{severity=\"HIGH\"}",
          "legendFormat": "{{image}}",
          "instant": true,
          "refId": "HIGH",
          "format": "table"
        },
        {
          "expr": "trivy_vulnerability_count{severity=\"MEDIUM\"}",
          "legendFormat": "{{image}}",
          "instant": true,
          "refId": "MEDIUM",
          "format": "table"
        },
        {
          "expr": "trivy_vulnerability_count{severity=\"LOW\"}",
          "legendFormat": "{{image}}",
          "instant": true,
          "refId": "LOW",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": { "byField": "image" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "severity 1": true,
              "severity 2": true,
              "severity 3": true,
              "severity 4": true
            },
            "renameByName": {
              "image": "Image",
              "Value #CRITICAL": "Critical",
              "Value #HIGH": "High",
              "Value #MEDIUM": "Medium",
              "Value #LOW": "Low"
            },
            "indexByName": {
              "image": 0,
              "Value #CRITICAL": 1,
              "Value #HIGH": 2,
              "Value #MEDIUM": 3,
              "Value #LOW": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Critical", "desc": true }] }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Image" },
            "properties": [{ "id": "custom.width", "value": 350 }]
          },
          {
            "matcher": { "id": "byName", "options": "Critical" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 1 }] } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "High" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Medium" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "yellow", "value": 1 }] } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Critical", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "countRows": false
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 103,
      "title": "Scan Info",
      "type": "row"
    },
    {
      "id": 30,
      "title": "Last Scan Time",
      "type": "stat",
      "gridPos": { "h": 3, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_scan_timestamp",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Never", "color": "red" }
              }
            }
          ]
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "value" }
    },
    {
      "id": 31,
      "title": "Scan Errors",
      "type": "stat",
      "gridPos": { "h": 3, "w": 8, "x": 8, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "trivy_scan_errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "graphMode": "none", "textMode": "value", "colorMode": "background" }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
