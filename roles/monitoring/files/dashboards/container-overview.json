    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 201,
      "title": "All Containers",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Container Resource Matrix",
      "type": "table",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": { "type": "auto" },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Container" },
            "properties": [
              { "id": "custom.width", "value": 170 },
              { "id": "custom.align", "value": "left" },
              { "id": "custom.cellOptions", "value": { "type": "auto" } },
              { "id": "links", "value": [{ "title": "Details", "url": "/d/containers?var-container=${__data.fields.Container}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Pod" },
            "properties": [
              { "id": "custom.width", "value": 140 },
              { "id": "custom.align", "value": "left" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 0.001 },
                    { "color": "#FF983080", "value": 0.3 },
                    { "color": "#F2495C99", "value": 0.7 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 1 },
                    { "color": "#FF983080", "value": 268435456 },
                    { "color": "#F2495C99", "value": 536870912 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mem %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#73BF69", "value": null },
                    { "color": "#FF9830", "value": 0.6 },
                    { "color": "#F2495C", "value": 0.85 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Net In" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 1 },
                    { "color": "#FF983080", "value": 1048576 },
                    { "color": "#F2495C99", "value": 10485760 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Net Out" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 1 },
                    { "color": "#FF983080", "value": 1048576 },
                    { "color": "#F2495C99", "value": 10485760 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disk R" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 1 },
                    { "color": "#FF983080", "value": 5242880 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disk W" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 1 },
