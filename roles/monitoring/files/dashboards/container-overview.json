            ]
          },
          {
            "matcher": { "id": "byName", "options": "PIDs" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.width", "value": 70 },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "#56A64B33", "value": 1 },
                    { "color": "#FF983080", "value": 50 },
                    { "color": "#F2495C99", "value": 200 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Memory", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["CPU %", "Memory", "Net In", "Net Out", "Disk R", "Disk W", "PIDs"]
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "name", "mode": "outer" }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(name|pod_name|Value #cpu|Value #mem|Value #mempct|Value #netin|Value #netout|Value #diskr|Value #diskw|Value #pids)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "name": 0,
              "pod_name": 1,
              "Value #cpu": 2,
              "Value #mem": 3,
              "Value #mempct": 4,
              "Value #netin": 5,
              "Value #netout": 6,
              "Value #diskr": 7,
              "Value #diskw": 8,
              "Value #pids": 9
            },
            "renameByName": {
              "name": "Container",
              "pod_name": "Pod",
              "Value #cpu": "CPU %",
              "Value #mem": "Memory",
              "Value #mempct": "Mem %",
              "Value #netin": "Net In",
              "Value #netout": "Net Out",
              "Value #diskr": "Disk R",
              "Value #diskw": "Disk W",
              "Value #pids": "PIDs"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "container:cpu_usage:rate5m",
          "legendFormat": "{{name}}",
          "refId": "cpu",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:memory_usage:bytes",
          "legendFormat": "{{name}}",
          "refId": "mem",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:memory_utilisation:ratio",
          "legendFormat": "{{name}}",
          "refId": "mempct",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:net_input:rate5m",
          "legendFormat": "{{name}}",
          "refId": "netin",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:net_output:rate5m",
          "legendFormat": "{{name}}",
          "refId": "netout",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:block_input:rate5m",
          "legendFormat": "{{name}}",
          "refId": "diskr",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:block_output:rate5m",
          "legendFormat": "{{name}}",
          "refId": "diskw",
          "format": "table",
          "instant": true
        },
        {
          "expr": "container:pids:current",
          "legendFormat": "{{name}}",
          "refId": "pids",
          "format": "table",
          "instant": true
        }
      ]
    },

