{
  "id": null,
  "uid": "container-status",
  "title": "Container Status",
  "description": "Portainer-style container health: live status, resource usage, and state history for all containers",
  "tags": ["containers", "status", "podman", "health"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Summary",
      "type": "row"
    },

    {
      "id": 1,
      "title": "Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "count(podman_container_state == 2) - count(podman_container_info{name=~\".*-infra\"} * on(id) group_left() podman_container_state) or vector(0)",
          "legendFormat": "Running",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 2,
      "title": "Stopped / Problem",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "count((podman_container_state * on(id) group_left(name) podman_container_info{name!~\".*-infra\"}) > 2) or vector(0)",
          "legendFormat": "Stopped",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 3,
      "title": "Total Containers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "count(podman_container_state * on(id) group_left(name) podman_container_info{name!~\".*-infra\"}) or vector(0)",
          "legendFormat": "Total",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 4,
      "title": "Total CPU",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "sum(container:cpu_usage:rate5m)",
          "legendFormat": "CPU",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Total Memory",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 536870912 },
              { "color": "red", "value": 1073741824 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "expr": "sum(container:memory_usage:bytes)",
          "legendFormat": "Memory",
          "refId": "A"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Container Health",
      "type": "row"
    },

    {
      "id": 10,
      "title": "Container Status",
      "type": "table",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "running":  { "text": "● running",  "color": "green" } } },
                  { "type": "value", "options": { "exited":   { "text": "● exited",   "color": "red" } } },
                  { "type": "value", "options": { "stopped":  { "text": "● stopped",  "color": "red" } } },
                  { "type": "value", "options": { "dead":     { "text": "● dead",     "color": "dark-red" } } },
                  { "type": "value", "options": { "paused":   { "text": "● paused",   "color": "orange" } } },
                  { "type": "value", "options": { "created":  { "text": "● created",  "color": "blue" } } },
                  { "type": "special", "options": { "match": "null", "result": { "text": "unknown", "color": "gray" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.5 },
                    { "color": "red", "value": 0.8 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memory" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Mem %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.7 },
                    { "color": "red", "value": 0.9 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "PIDs" },
            "properties": [
              { "id": "custom.width", "value": 70 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Container" },
            "properties": [
              { "id": "custom.width", "value": 200 },
              { "id": "links", "value": [
                {
                  "title": "Container Metrics",
                  "url": "/d/containers?var-container=${__value.raw}&${__url_time_range}"
                }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Pod" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          },
          {
            "matcher": { "id": "byName", "options": "Image" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "options": {
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [{ "displayName": "Status", "desc": false }],
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": ["name", "pod_name", "image", "status", "CPU %", "Memory", "Mem %", "PIDs"]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "name": "Container",
              "pod_name": "Pod",
              "image": "Image",
              "status": "Status"
            },
            "indexByName": {
              "Container": 0,
              "Pod": 1,
              "Status": 2,
              "CPU %": 3,
              "Memory": 4,
              "Mem %": 5,
              "PIDs": 6,
              "Image": 7
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "podman_container_info{name!~\".*-infra\"} * on(id) group_left() (podman_container_state > 0)",
          "legendFormat": "{{name}}",
          "refId": "Info",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum by (name, pod_name) (container:cpu_usage:rate5m)",
          "legendFormat": "CPU %",
          "refId": "CPU",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum by (name, pod_name) (container:memory_usage:bytes)",
          "legendFormat": "Memory",
          "refId": "Mem",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum by (name, pod_name) (container:memory_utilisation:ratio)",
          "legendFormat": "Mem %",
          "refId": "MemPct",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "sum by (name, pod_name) (container:pids:current)",
          "legendFormat": "PIDs",
          "refId": "PIDs",
          "instant": true,
          "format": "table"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 102,
      "title": "State History (last 3h)",
      "type": "row"
    },

    {
      "id": 20,
      "title": "Container State Timeline",
      "description": "State values: 2=running 3=stopped 4=paused 7=exited 8=dead",
      "type": "state-timeline",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 70 },
          "mappings": [
            { "type": "value", "options": { "2": { "text": "running", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "configured", "color": "blue", "index": 1 } } },
            { "type": "value", "options": { "3": { "text": "stopped", "color": "red", "index": 2 } } },
            { "type": "value", "options": { "4": { "text": "paused", "color": "orange", "index": 3 } } },
            { "type": "value", "options": { "5": { "text": "exiting", "color": "orange", "index": 4 } } },
            { "type": "value", "options": { "7": { "text": "exited", "color": "red", "index": 5 } } },
            { "type": "value", "options": { "8": { "text": "dead", "color": "dark-red", "index": 6 } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "podman_container_state * on(id) group_left(name, pod_name) podman_container_info{name!~\".*-infra\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }

  ],
  "schemaVersion": 38
}
