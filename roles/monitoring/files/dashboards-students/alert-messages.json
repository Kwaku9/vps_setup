    {
      "type": "timeseries",
      "title": "Firing instances vs distinct alerts",
      "description": "The two lines normally track each other. When they diverge, a single rule is producing many instances \u2014 the signature of an unaggregated comparison over a high-cardinality metric.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "range": true,
          "refId": "A",
          "legendFormat": "firing instances"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "count(count by (alertname) (ALERTS{alertstate=\"firing\"})) or vector(0)",
          "range": true,
          "refId": "B",
          "legendFormat": "distinct alerts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
