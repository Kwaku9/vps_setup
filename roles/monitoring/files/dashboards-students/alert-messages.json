    {
      "type": "stat",
      "title": "Fan-out (instances per alert)",
      "description": "Firing instances divided by distinct alert rules. Healthy is ~1-2. Sustained high values mean one rule is multiplying across a label it should have aggregated away \u2014 the 2026-09-05 HoneypotSilent bug peaked at 78.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "(count(ALERTS{alertstate=\"firing\"}) or vector(0)) / clamp_min(count(count by (alertname) (ALERTS{alertstate=\"firing\"})), 1)",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          },
          "unit": "short",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      }
    },
