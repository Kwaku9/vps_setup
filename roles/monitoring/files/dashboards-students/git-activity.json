    {
      "id": 1,
      "title": "Contribution Heatmap",
      "description": "GitHub-style contribution heatmap showing daily commit activity",
      "type": "volkovlabs-echarts-panel",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-student"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-student"
          },
          "format": "table",
          "rawSql": "SELECT\n    TO_CHAR(committed_at::date, 'YYYY-MM-DD') AS commit_date,\n    COUNT(*) AS commits,\n    SUM(insertions) AS insertions,\n    SUM(deletions) AS deletions\nFROM student_view.git_commits\nWHERE committed_at BETWEEN $__timeFrom() AND $__timeTo()\n  AND ($repo = 0 OR repo_id = $repo)\nGROUP BY committed_at::date\nORDER BY 1",
          "refId": "A"
        }
      ],
      "options": {
        "renderer": "canvas",
        "editor": {
          "height": 600,
          "format": "auto"
        },
        "getOption": "const data = context.panel.data.series[0];\nif (!data || !data.fields || data.fields.length === 0) return {};\n\nconst dates = data.fields.find(f => f.name === 'commit_date');\nconst counts = data.fields.find(f => f.name === 'commits');\nif (!dates || !counts) return {};\n\nconst calendarData = [];\nlet maxVal = 0;\nfor (let i = 0; i < dates.values.length; i++) {\n    const val = counts.values[i];\n    calendarData.push([dates.values[i], val]);\n    if (val > maxVal) maxVal = val;\n}\n\nconst from = context.grafana.replaceVariables('${__from:date:YYYY-MM-DD}');\nconst to = context.grafana.replaceVariables('${__to:date:YYYY-MM-DD}');\n\nreturn {\n    tooltip: {\n        formatter: function(p) {\n            return p.value[0] + '<br/>Commits: ' + p.value[1];\n        }\n    },\n    visualMap: {\n        min: 0,\n        max: Math.max(maxVal, 1),\n        calculable: false,\n        orient: 'horizontal',\n        left: 'center',\n        bottom: 0,\n        inRange: {\n            color: ['#161b22', '#0e4429', '#006d32', '#26a641', '#39d353']\n        },\n        textStyle: { color: '#ccc' }\n    },\n    calendar: {\n        range: [from, to],\n        cellSize: ['auto', 15],\n        top: 40,\n        left: 60,\n        right: 40,\n        itemStyle: {\n            borderWidth: 3,\n            borderColor: '#1a1a2e'\n        },\n        splitLine: { show: false },\n        dayLabel: { color: '#8b949e', fontSize: 10 },\n        monthLabel: { color: '#8b949e', fontSize: 11 },\n        yearLabel: { show: false }\n    },\n    series: [{\n        type: 'heatmap',\n        coordinateSystem: 'calendar',\n        data: calendarData\n    }]\n};"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
