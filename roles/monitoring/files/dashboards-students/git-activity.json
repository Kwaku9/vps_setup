    {
      "id": 10,
      "title": "Tokens per Commit (Session-Linked)",
      "description": "Commits linked to Claude Code sessions showing token usage and tool calls",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-student"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-student"
          },
          "format": "table",
          "rawSql": "SELECT\n    gc.short_hash AS \"Hash\",\n    gr.repo_name AS \"Repo\",\n    LEFT(gc.commit_message, 60) AS \"Message\",\n    gc.files_changed AS \"Files\",\n    gc.insertions AS \"+Lines\",\n    gc.deletions AS \"-Lines\",\n    s.input_tokens + s.output_tokens AS \"Session Tokens\",\n    ROUND(s.duration_seconds / 60.0, 1) AS \"Session Min\",\n    s.total_tool_calls AS \"Tools Used\",\n    gc.committed_at AS \"Date\"\nFROM student_view.git_commits gc\nJOIN student_view.sessions s ON gc.session_id = s.id\nJOIN student_view.git_repos gr ON gc.repo_id = gr.id\nWHERE gc.committed_at BETWEEN $__timeFrom() AND $__timeTo()\nAND ($repo = 0 OR gc.repo_id = $repo)\nORDER BY gc.committed_at DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hash"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Message"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 350
              }
            ]
          },
          {
            "matcher": {
