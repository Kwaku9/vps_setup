    {
      "id": 11,
      "title": "Activity Pattern - Day x Hour",
      "description": "Heatmap of commit activity by day of week and hour",
      "type": "volkovlabs-echarts-panel",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-student"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-student"
          },
          "format": "table",
          "rawSql": "SELECT\n    EXTRACT(DOW FROM committed_at)::int AS dow,\n    EXTRACT(HOUR FROM committed_at)::int AS hour,\n    COUNT(*) AS count\nFROM student_view.git_commits\nWHERE committed_at BETWEEN $__timeFrom() AND $__timeTo()\nAND ($repo = 0 OR repo_id = $repo)\nGROUP BY 1, 2 ORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "options": {
        "renderer": "canvas",
        "editor": {
          "height": 600,
          "format": "auto"
        },
        "getOption": "const data = context.panel.data.series[0];\nif (!data || !data.fields || data.fields.length === 0) return {};\n\nconst dow = data.fields.find(f => f.name === 'dow');\nconst hour = data.fields.find(f => f.name === 'hour');\nconst count = data.fields.find(f => f.name === 'count');\nif (!dow || !hour || !count) return {};\n\nconst heatData = [];\nlet maxVal = 0;\nfor (let i = 0; i < dow.values.length; i++) {\n    heatData.push([hour.values[i], dow.values[i], count.values[i]]);\n    if (count.values[i] > maxVal) maxVal = count.values[i];\n}\n\nconst days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];\nconst hours = Array.from({length: 24}, (_, i) => i + ':00');\n\nreturn {\n    tooltip: {\n        formatter: function(p) {\n            return days[p.value[1]] + ' ' + p.value[0] + ':00<br/>Commits: ' + p.value[2];\n        }\n    },\n    xAxis: { type: 'category', data: hours, splitArea: { show: true }, axisLabel: { color: '#8b949e' } },\n    yAxis: { type: 'category', data: days, splitArea: { show: true }, axisLabel: { color: '#8b949e' } },\n    visualMap: {\n        min: 0, max: Math.max(maxVal, 1),\n        calculable: false, orient: 'horizontal', left: 'center', bottom: 0,\n        inRange: { color: ['#0d1117', '#1f6feb', '#58a6ff', '#79c0ff'] },\n        textStyle: { color: '#ccc' }\n    },\n    series: [{\n        type: 'heatmap',\n        data: heatData,\n        label: { show: false },\n        itemStyle: { borderWidth: 2, borderColor: '#1a1a2e' }\n    }]\n};"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
