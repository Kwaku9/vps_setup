#!/bin/sh
# cron-shell: the SHELL for root's crontab (cronie runs `$SHELL -c "<command>"`).
#
# Runs the job exactly as /bin/sh would, then records how it went so a failing
# job pages someone (vmalert CronJobFailed). Before this, nothing recorded a
# cron job's exit status: geoip-refresh failed every week for months unseen.
#
# Per job, in /opt/compose/textfile-collector/cron_<name>.prom (node-exporter):
#   cron_job_last_exit_code{cron_job}             exit status of the last run
#   cron_job_last_run_timestamp_seconds{cron_job} when it last finished
#   cron_job_last_duration_seconds{cron_job}      how long it took
#   cron_job_last_success_timestamp_seconds{...}  last run that exited 0
#   cron_job_last_cpu_seconds{cron_job}           user+system CPU of the last run
#   cron_job_last_max_rss_bytes{cron_job}         peak memory of the last run
# The job's own exit status is returned unchanged, and a failure to write the
# metrics never affects the job. The label is cron_job, not job: node-exporter
# scrapes already carry job="node-exporter".

[ "$1" = "-c" ] || exec /bin/sh "$@"
cmd=$2
start=$(date +%s)
# BusyBox `time -v -o FILE` measures CPU and peak memory, writes its report to
# FILE only, and returns the job's own exit status; the job's stdout/stderr are
# untouched. Without it (or a temp file), run the job plainly.
tf=$(mktemp /tmp/.cron-time.XXXXXX 2>/dev/null) || tf=
if [ -n "$tf" ] && busybox time -v -o /dev/null true >/dev/null 2>&1; then
    busybox time -v -o "$tf" /bin/sh -c "$cmd"
    rc=$?
else
    /bin/sh -c "$cmd"
    rc=$?
fi
end=$(date +%s)

{
    dir=${CRON_SHELL_DIR:-/opt/compose/textfile-collector}
    tab=${CRON_SHELL_CRONTAB:-/etc/crontabs/root}
    # Name the job by the "#Ansible: <name>" comment above its crontab line;
    # fall back to the command's program name for unmanaged lines.
    name=$(awk -v c="$cmd" 'index($0, c) && prev ~ /^#Ansible: / { sub(/^#Ansible: /, "", prev); print prev; exit } { prev = $0 }' "$tab" 2>/dev/null)
    [ -n "$name" ] || name=$(basename "$(printf '%s' "$cmd" | awk '{for (i = 1; i <= NF; i++) if ($i ~ /^\//) {print $i; exit}}')" 2>/dev/null)
    [ -n "$name" ] || name=unknown
    slug=$(printf '%s' "$name" | tr -c 'A-Za-z0-9_\n' '_' | cut -c1-80)
    label=$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')
    file="$dir/cron_$slug.prom"
    last_ok=$(awk '/^cron_job_last_success_timestamp_seconds/ {print $NF}' "$file" 2>/dev/null)
    cpu= rss=
    if [ -n "$tf" ] && [ -s "$tf" ]; then
        cpu=$(awk -F': ' '/User time|System time/ {s += $2} END {if (NR) printf "%.2f", s}' "$tf")
        rss=$(awk -F': ' '/Maximum resident set size/ {print $2 * 1024}' "$tf")
    fi
    [ "$rc" -eq 0 ] && last_ok=$end
    if tmp=$(mktemp "$dir/.cron_$slug.XXXXXX"); then
        {
            echo "cron_job_last_exit_code{cron_job=\"$label\"} $rc"
            echo "cron_job_last_run_timestamp_seconds{cron_job=\"$label\"} $end"
            echo "cron_job_last_duration_seconds{cron_job=\"$label\"} $((end - start))"
            [ -n "$last_ok" ] && echo "cron_job_last_success_timestamp_seconds{cron_job=\"$label\"} $last_ok"
            [ -n "$cpu" ] && echo "cron_job_last_cpu_seconds{cron_job=\"$label\"} $cpu"
            [ -n "$rss" ] && echo "cron_job_last_max_rss_bytes{cron_job=\"$label\"} $rss"
        } > "$tmp"
        # 0644: node-exporter is not root; a 0600 .prom drops every series in it.
        chmod 0644 "$tmp" && mv -f "$tmp" "$file"
    fi
} 2>/dev/null || true
[ -n "$tf" ] && rm -f "$tf"

exit "$rc"
