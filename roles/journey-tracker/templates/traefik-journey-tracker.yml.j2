# Journey Tracker - Timeline visualization
# Generated by Ansible
http:
  routers:
    journey-tracker:
      rule: "Host(`{{ journey_tracker.domain }}.{{ domain_name }}`)"
      entryPoints:
        - websecure
      service: journey-tracker
      tls:
        certResolver: cloudflare

  services:
    journey-tracker:
      loadBalancer:
        servers:
          - url: "http://{{ journey_tracker.container_name }}:{{ journey_tracker.internal_port }}"
