# ============================================
# VPS Setup - Ansible Deployment Configuration
# ============================================
# Only deployment-critical Ansible files are tracked
# Documentation, scripts, and development artifacts excluded

# ============================================
# Documentation
# ============================================
docs/
CLAUDE.md
GEMINI.md
*.md
# Keep main (root) README for deployment notes — anchored so sub-project READMEs stay ignored
!/README.md

# ============================================
# Utility Scripts (Non-Deployment)
# ============================================
scripts/
*.sh
*.ps1
# Exception: needed for container
!entrypoint.sh

# ============================================
# Claude/AI Instructions
# ============================================
.claude/
# Superpowers brainstorm session scratch/state (PIDs, logs, HTML)
.superpowers/

# ============================================
# Media Files
# ============================================
screenshots/
*.png
*.jpg
*.jpeg
*.gif
*.svg

# ============================================
# Task-Specific Playbooks (Not Core Deployment)
# ============================================
# Uncomment to exclude one-off task playbooks:
# claude-restore.yml
# claude-transfer.yml
# transfer-workspace-agents.yml
# docker-compose-openwebui.yml
# backend-info.txt.j2
# services-info.txt.j2

# ============================================
# Inventory (contains real IPs)
# ============================================
inventory/hosts

# ============================================
# Secrets & Credentials (NEVER COMMIT!)
# ============================================
.vault_pass
vault-pass.txt
vault copy.yml
vault.yml
vault.yml.bak*
vault.yml.*bak*
vault.yml.pre-*
vault_password.txt
*.pem
*.key
id_rsa*
id_ed25519*
credentials.json
token.json

# ============================================
# IDE & Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Language-Specific Build Artifacts
# ============================================
# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Node.js
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# ============================================
# Ansible Runtime
# ============================================
*.retry
*.log

# ============================================
# Data Files
# ============================================
*.csv
*.m4a

# ============================================
# Build Artifacts & Temporary Files
# ============================================
*.tar.gz
*.zip
backend-info.txt
services-info.txt
tmp/
temp/
*.tmp
nul

# ============================================
# Backup Files
# ============================================
*.backup
*.bak
*.orig
*~

# ============================================
# Docker
# ============================================
# Only needed locally, not in repo
.dockerignore
expressions.txt

# Build/runtime artifacts under mcp-servers/files (added 2026-04-12)
roles/mcp-servers/files/mcp-googledocs-server/*.mp4
roles/mcp-servers/files/mcp-googledocs-server/*.gif
roles/mcp-servers/files/mcp-googledocs-server/assets/*.mp4
roles/mcp-servers/files/mcp-googledocs-server/assets/*.gif
roles/mcp-servers/files/mcp-googledocs-server/repomix-output.*
roles/mcp-servers/files/scrapy-mcp/properties.*
roles/mcp-servers/files/scrapy-mcp/output.*

# Flyer generator runtime output — container writes PDFs here
flyers/output/*
!flyers/output/.gitkeep

# Batch 11 (2026-04-12): local runtime artifacts, not source of truth
# Third-party clone (tanbiralam/claude-code) with its own .git dir
/claude-code/
# Fabric CLI venv
/tools/fabric-venv/
# Rendered from tools/telegram-approval.json.j2 via vault pre_task — never commit
/tools/telegram-approval.json

# Worktrees (local-only, never committed)
.worktrees/
!run-daily-timeline.sh
!sync-sessions-to-vps.sh
!workstation-systemd/
roles/mcp-servers/files/telegram-gateway/.venv/
!tools/check-vps-drift.sh

# Local-only working dir (backups, ETL scratch, dev plans, secrets — never commit)
local/
# Spike/experiment scratch (datasets, spike.env secrets, notebooks) — never canonical.
# Nothing here is tracked; commit a spike tool explicitly with `git add -f` if needed.
tools/spikes/
# Playwright MCP session artifacts (transient tool output)
.playwright-mcp/

# Bundled Claude Code skills deployed via claude-prep — track the WHOLE skill tree
# (overrides the global *.md and *.sh ignores above for SKILL.md, reference.md, *.sh helpers)
!roles/claude-prep/files/skills/**/*.md
!roles/claude-prep/files/skills/**/*.sh

# ─── added 2026-07-30 during Phase 0 backup — do not remove ───
# credentials / secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
!example.env
config.env
credentials.json
token.json
token-old.json
token.pickle
client_secret*.json
service-account*.json
secrets.y*ml
secrets.env
vault.yml
**/group_vars/**/vault.yml
.vault_pass
*vault_pass*
