*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.example.tfvars
!example*.tfvars
# dependencies / build output
node_modules/
.venv/
venv/
my_cdk_env/
__pycache__/
*.py[cod]
dist/
build/
cdk.out/
.next/
lambda_package/
site-packages/
