          "rawSql": "SELECT ticker, price, iv, hv20, iv_hv_ratio, z_score, iv_rank, score, signal, scan_time\nFROM trading.iv_scan_results\nWHERE scan_direction = 'high'\n  AND scan_time = (SELECT MAX(scan_time) FROM trading.iv_scan_results WHERE scan_direction = 'high')\nORDER BY score DESC\nLIMIT 15",
