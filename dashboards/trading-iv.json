    {
      "id": 3,
      "title": "Z-Score Time Series",
      "description": "IV Z-scores over time per ticker with price overlay",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 21 },
      "datasource": { "type": "postgres", "uid": "postgres-trading" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "spanNulls": true,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": -1.75 },
              { "color": "transparent", "value": -1.0 },
              { "color": "transparent", "value": 1.0 },
              { "color": "yellow", "value": 1.75 },
              { "color": "red", "value": 2.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "rawSql": "SELECT scan_time AS time, z_score AS \"$ticker\", ticker\nFROM trading.iv_scan_results\nWHERE $__timeFilter(scan_time)\n  AND ('$ticker' = '$__all' OR ticker IN ($ticker))\nORDER BY scan_time",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "IV Rank Gauge",
      "description": "Current IV rank for selected ticker(s)",
      "type": "gauge",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "postgres", "uid": "postgres-trading" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "rawSql": "SELECT ticker, iv_rank\nFROM trading.iv_scan_results r\nINNER JOIN (\n  SELECT ticker AS t, MAX(scan_time) AS max_time\n  FROM trading.iv_scan_results\n  GROUP BY ticker\n) latest ON r.ticker = latest.t AND r.scan_time = latest.max_time\nWHERE ('$ticker' = '$__all' OR r.ticker IN ($ticker))\nORDER BY iv_rank DESC\nLIMIT 8",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "Heatmap & Recurring Candidates",
