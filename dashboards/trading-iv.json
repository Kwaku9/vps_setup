    {
      "id": 4,
      "title": "IV Z-Score Heatmap",
      "description": "Stocks x scan dates — color intensity = Z-score magnitude",
      "type": "volkovlabs-echarts-panel",
      "gridPos": { "h": 12, "w": 16, "x": 0, "y": 32 },
      "datasource": { "type": "postgres", "uid": "postgres-trading" },
      "options": {
        "renderer": "canvas",
        "editor": {
          "height": 600,
          "format": "javascript"
        },
        "getOption": "// Fetch data from query results\nconst data = context.panel.data.series[0];\nif (!data || !data.fields || data.fields.length < 3) {\n  return { title: { text: 'No data available', left: 'center', top: 'center' } };\n}\n\nconst tickerField = data.fields.find(f => f.name === 'ticker');\nconst dateField = data.fields.find(f => f.name === 'scan_date');\nconst zField = data.fields.find(f => f.name === 'z_score');\n\nif (!tickerField || !dateField || !zField) {\n  return { title: { text: 'Missing fields', left: 'center', top: 'center' } };\n}\n\nconst tickers = [...new Set(tickerField.values)];\nconst dates = [...new Set(dateField.values)].sort();\n\nconst heatData = [];\nfor (let i = 0; i < tickerField.values.length; i++) {\n  const x = dates.indexOf(dateField.values[i]);\n  const y = tickers.indexOf(tickerField.values[i]);\n  const val = Number(zField.values[i]);\n  heatData.push([x, y, val]);\n}\n\nreturn {\n  tooltip: {\n    position: 'top',\n    formatter: function(p) {\n      return `${tickers[p.value[1]]} | ${dates[p.value[0]]}<br/>Z-Score: ${p.value[2].toFixed(2)}`;\n    }\n  },\n  grid: { top: 30, bottom: 60, left: 80, right: 30 },\n  xAxis: {\n    type: 'category',\n    data: dates,\n    axisLabel: { rotate: 45, fontSize: 10 },\n    splitArea: { show: true }\n  },\n  yAxis: {\n    type: 'category',\n    data: tickers,\n    axisLabel: { fontSize: 10 },\n    splitArea: { show: true }\n  },\n  visualMap: {\n    min: -3,\n    max: 3,\n    calculable: true,\n    orient: 'horizontal',\n    left: 'center',\n    bottom: 0,\n    inRange: {\n      color: ['#313695', '#4575b4', '#74add1', '#f7f7f7', '#fdae61', '#f46d43', '#a50026']\n    }\n  },\n  series: [{\n    type: 'heatmap',\n    data: heatData,\n    label: { show: false },\n    emphasis: {\n      itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.5)' }\n    }\n  }]\n};"
      },
      "targets": [
        {
          "rawSql": "SELECT ticker, scan_time::date::text AS scan_date, z_score\nFROM trading.iv_scan_results\nWHERE $__timeFilter(scan_time)\n  AND ('$ticker' = '$__all' OR ticker IN ($ticker))\nORDER BY scan_time, ticker",
          "format": "table",
          "refId": "A"
        }
      ]
