        "footer": {
          "fields": [
            "CPU %",
            "Memory",
            "Net In",
            "Net Out",
            "Disk R",
            "Disk W",
            "PIDs"
          ],
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Memory"
          }
        ]
      },
      "targets": [
        {
          "expr": "(podman_container_cpu_percent / 100 * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "cpu"
        },
        {
          "expr": "(podman_container_mem_usage_bytes * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "mem"
        },
        {
          "expr": "((podman_container_mem_usage_bytes * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"}) / clamp_min((podman_container_mem_limit_bytes * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"}), 1))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "mempct"
        },
        {
          "expr": "(rate(podman_container_net_input_total[5m]) * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "netin"
        },
        {
          "expr": "(rate(podman_container_net_output_total[5m]) * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "netout"
        },
        {
          "expr": "(rate(podman_container_block_input_total[5m]) * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "diskr"
        },
        {
          "expr": "(rate(podman_container_block_output_total[5m]) * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "diskw"
        },
        {
          "expr": "(podman_container_pids * on(id) group_left(name, pod_name, image) podman_container_info{name!~\".*-infra\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "refId": "pids"
        }
      ],
      "title": "Container Resource Matrix",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(name|pod_name|Value #cpu|Value #mem|Value #mempct|Value #netin|Value #netout|Value #diskr|Value #diskw|Value #pids)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Value #cpu": 2,
              "Value #diskr": 7,
              "Value #diskw": 8,
              "Value #mem": 3,
              "Value #mempct": 4,
              "Value #netin": 5,
              "Value #netout": 6,
              "Value #pids": 9,
              "name": 0,
              "pod_name": 1
            },
            "renameByName": {
              "Value #cpu": "CPU %",
              "Value #diskr": "Disk R",
              "Value #diskw": "Disk W",
              "Value #mem": "Memory",
              "Value #mempct": "Mem %",
              "Value #netin": "Net In",
              "Value #netout": "Net Out",
              "Value #pids": "PIDs",
              "name": "Container",
              "pod_name": "Pod"
            }
          }
        }
      ],
      "type": "table"
    },
