        <mxCell id="net_label" value="&lt;b&gt;enterprise_network&lt;/b&gt; — REDACTED_CIDR — Podman Bridge (aardvark-dns)&lt;br/&gt;All pods share this network. DNS resolves pod names (not container names)." style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFDE7;fontSize=8;fontColor=#37474F;fillColor=#E3F2FD;fontSize=9;" parent="layer_engineering" vertex="1">
          <mxGeometry x="1200" y="2120" width="500" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="spend_label" value="&lt;b&gt;End-User Spend Tracking Flow:&lt;/b&gt;&lt;br/&gt;1. User logs in via Authentik OIDC → OpenWebUI&lt;br/&gt;2. OpenWebUI sends x-openwebui-user-email header&lt;br/&gt;3. LiteLLM maps header → user field (user_header_name)&lt;br/&gt;4. Per-user cost tracked in PostgreSQL&lt;br/&gt;5. OTEL traces include user metadata" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFDE7;fontSize=8;fontColor=#37474F;fillColor=#E8F5E9;fontSize=9;" parent="layer_aimodels" vertex="1">
          <mxGeometry x="100" y="2120" width="350" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="tts_label" value="&lt;b&gt;AI Voice Pipeline:&lt;/b&gt;&lt;br/&gt;1. AI generates text response&lt;br/&gt;2. REDACTED_DOMAIN calls Kokoro TTS&lt;br/&gt;   /v1/audio/speech (OpenAI-compatible)&lt;br/&gt;3. Kokoro runs CPU inference (containerized)&lt;br/&gt;4. Audio streamed back to user browser" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#FFFDE7;fontSize=8;fontColor=#37474F;fillColor=#FFF3E0;fontSize=9;" parent="layer_aimodels" vertex="1">
