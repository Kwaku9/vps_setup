        hp[honeypot]:::sec
        tm[threat-map]:::sec
        ais[ais-relay ⚠down]:::svc
        tetra[tetragon<br/>eBPF]:::sec
    end
    ops --> pg
    ops --> vm
    tg --> pg
    tg --> llm
    tg --> kok
    tg --> graf
    tgc --> llm
    owc --> llm
    srm --> pg
    tca --> neo
    tm --> cs
    tm --> loki

    %% ---------------- OTLP fan-in ----------------
    owui & llm & kok & tg & tf & tetra -. otlp .-> alloy

    %% ---------------- OIDC ----------------
    graf & owui & tm -. OIDC .-> aks

    %% ---------------- Traefik routes (representative) ----------------
    tf --> owui & llm & kok & graf & vm & aks & ops & ngx & wv & atl & jt & tg & tgc & tm & hp & decks & tca

    %% ---------------- Host / SSH / eBPF edges ----------------
    host[(alpine-vps host)]:::host
    tg -. ssh .-> host
    ops -. ssh .-> host
    tetra -. ebpf .-> host

