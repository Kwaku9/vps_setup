flowchart TB
    %% ---------------- Edge / Ingress ----------------
    internet([Internet / Users]):::ext
    cfedge{{Cloudflare Edge + Access}}:::ext
    subgraph EDGE["🌐 Ingress edge (standalone)"]
        direction LR
        cfd[cloudflared<br/>tunnel]:::edge
        tf[traefik v3.7<br/>:80/:443]:::edge
        cs[crowdsec<br/>LAPI :8180]:::sec
    end
    internet --> cfedge -->|"aicortex.cloud + *.<br/>(21 hostnames)"| cfd -->|https| tf
    tf -. bouncer .-> cs

    %% ---------------- AI stack ----------------
    subgraph AI["🤖 ai-stack-pod"]
        direction TB
        owui[open-webui<br/>v0.9.6 :8080]:::app
        llm[litellm<br/>:4000]:::app
        kok[kokoro-tts<br/>:8880]:::svc
        sxng[searxng]:::svc
        gtts[gemini-tts-proxy]:::svc
        aspg[(ai-stack-postgres<br/>litellm · memory✓pgvector)]:::db
    end
    owui --> llm
    owui --> kok
    owui --> sxng
    llm --> gtts
    llm --> aspg

    %% ---------------- Embeddings ----------------
    subgraph EMB["🧠 llama-embed-pod"]
        lme[llama-embed<br/>⚠ degraded]:::svc
    end
    llm -. embeddings .-> lme

    %% ---------------- Auth ----------------
    subgraph AUTH["🔐 authentication-pod (+worker pod)"]
        direction TB
        aks[authentik-server<br/>2026.5.2 :9000]:::auth
        akw[authentik-worker]:::auth
        akpg[(authentik-postgres)]:::db
        rds[(redis ⚠no-auth)]:::db
    end
    aks --> akpg
    aks --> rds
    akw --> akpg
    akw --> rds
    aks <--> akw

    %% ---------------- Shared data + graph ----------------
    subgraph DATA["🗄 shared-db-pod"]
        pg[(postgres · pgvector<br/>sessions·gateway·trading<br/>openwebui·recall·spike)]:::db
    end
    subgraph GRAPH["🕸 neo4j-pod"]
        neo[(neo4j-db<br/>:7687 service-map+sessions)]:::db
        nmcp[neo4j-mcp-server]:::mcp
    end
    nmcp --> neo

    %% ---------------- Observability ----------------
    subgraph OBS["📊 monitoring (metrics / logs / tempo + reports)"]
        direction TB
        vm[(victoriametrics<br/>:8428 · 20y)]:::obs
        vma[vmalert<br/>BLACKHOLE]:::obs
        graf[grafana<br/>13.1 :3000]:::app
        rend[renderer]:::svc
        grep[grafana-reports<br/>reports-pod]:::app
        loki[(loki :3100<br/>14d)]:::obs
        alloy[alloy<br/>collector :4317/8]:::obs
        tempo[(tempo :3200<br/>traces 7d)]:::obs
    end
    alloy --> loki
    alloy --> tempo
    alloy --> vm
    vma --> vm
    vm -. scrapes .-> llm & aks & cs & tf & loki & graf & cfd
    graf --> vm
    graf --> loki
    graf --> tempo
    graf --> pg
    graf --> rend
    grep --> graf
    grep --> rend

    %% ---------------- Apps / frontend ----------------
    subgraph FE["🖥 frontend-pod"]
        direction LR
        ngx[nginx<br/>portal]:::fe
        wv[worldview-dev<br/>:5173]:::fe
        atl[atlas-charts]:::fe
        jt[journey-tracker]:::fe
    end
    atl --> vm

    %% ---------------- Mgmt / integration / security ----------------
    subgraph MGMT["🛠 management + integration + security"]
        direction TB
        ops[ops-dashboard<br/>:8090]:::app
        tg[telegram-gateway<br/>:7555]:::app
        tgc[telegram-coder<br/>:7556]:::app
        owc[owui-coder<br/>:7557]:::app
        gdocs[google-docs-mcp]:::mcp
