[Unit]
Description=Private agent trajectory capture and curation
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/VScdeProjects/vps_setup/tools/trajectory-pipeline
EnvironmentFile=-%h/.config/trajectory-pipeline/environment
ExecStart=%h/Projects/VScdeProjects/vps_setup/tools/trajectory-pipeline/.venv/bin/trajectory --config config.local.toml cycle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
